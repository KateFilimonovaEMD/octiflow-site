---
interface Props {
  variant?: "header" | "home" | "home-cta" | "article";
  loading?: "eager" | "lazy";
}

const {
  variant = "header",
  loading,
} = Astro.props;

const variantClasses: Record<NonNullable<Props["variant"]>, string[]> = {
  header: ["store-badges"],
  home: ["home-store-badges"],
  "home-cta": ["home-store-badges", "home-store-badges--cta"],
  article: ["article-cta__store-badges"],
};
---

<div
  class:list={["store-links", ...variantClasses[variant]]}
  role="group"
  aria-label="Octi Flow app stores"
>
  <a
    class="store-link store-link--apple"
    href="https://apps.apple.com/app/octi-flow/id6783334530"
    target="_blank"
    rel="noopener noreferrer"
    aria-label="Download Octi Flow on the App Store"
  >
    <img
      class="store-link__image"
      src="/assets/img/app-store-badge.svg"
      alt="Download on the App Store"
      width="120"
      height="40"
      {loading}
      decoding="async"
    />
  </a>

  <span
    class="store-link store-link--google store-link--unavailable"
    role="img"
    aria-label="Octi Flow is not yet available on Google Play"
  >
    <img
      class="store-link__image"
      src="/assets/img/google-play-badge.png?v=20260731-2"
      alt=""
      width="564"
      height="168"
      {loading}
      decoding="async"
    />
  </span>
</div>
