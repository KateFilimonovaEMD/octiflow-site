---
const navigationItems = [
  { href: "/", label: "Home" },
  { href: "/blog/", label: "Blog" },
  { href: "/about/", label: "About" },
  { href: "/support/", label: "Support" },
  { href: "/contact/", label: "Contact" },
];

const currentPath = Astro.url.pathname;
const isCurrentPage = (href: string) =>
  href === "/" ? currentPath === "/" : currentPath.startsWith(href);
---

<nav aria-label="Primary navigation">
  <div class="container nav-inner">
    <a class="brand" href="/" aria-label="Octi Flow home">
      <img
        class="brand-logo"
        src="/assets/img/octi-flow-logo.png"
        alt="Octi Flow"
        width="552"
        height="218"
        decoding="async"
      />
    </a>

    <div class="desktop-menu">
      {
        navigationItems.map(({ href, label }) => (
          <a
            class="desktop-menu__link"
            href={href}
            aria-current={isCurrentPage(href) ? "page" : undefined}
          >
            {label}
          </a>
        ))
      }
    </div>

    <div
      class="store-badges"
      role="group"
      aria-label="Octi Flow app stores"
    >
      <a
        class="app-store-link"
        href="https://apps.apple.com/app/octi-flow/id6783334530"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="Download Octi Flow on the App Store"
      >
        <img
          class="app-store-badge"
          src="/assets/img/app-store-badge.svg"
          alt="Download on the App Store"
          width="120"
          height="40"
          decoding="async"
        />
      </a>

      <span
        class="google-play-unavailable"
        role="img"
        aria-label="Octi Flow is not yet available on Google Play"
      >
        <img
          class="google-play-badge"
          src="/assets/img/google-play-badge.png?v=20260731-2"
          alt=""
          width="564"
          height="168"
          decoding="async"
        />
      </span>
    </div>

    <button
      class="mobile-menu-toggle"
      type="button"
      aria-controls="mobile-navigation"
      aria-expanded="false"
      aria-label="Open menu"
    >
      <span></span>
      <span></span>
      <span></span>
    </button>
  </div>

  <div class="mobile-menu" id="mobile-navigation" hidden>
    <div class="container mobile-menu__inner">
      {
        navigationItems.map(({ href, label }) => (
          <a href={href} aria-current={isCurrentPage(href) ? "page" : undefined}>
            {label}
          </a>
        ))
      }
    </div>
  </div>
</nav>
