---
import StoreBadges from "./StoreBadges.astro";

const navigationItems = [
  { href: "/", label: "Home" },
  { href: "/blog/", label: "Blog" },
  { href: "/about/", label: "About" },
  { href: "/support/", label: "Support" },
  { href: "/contact/", label: "Contact" },
];

const currentPath = Astro.url.pathname;
const isCurrentPage = (href: string) =>
  href === "/" ? currentPath === "/" : currentPath.startsWith(href);
---

<nav aria-label="Primary navigation">
  <div class="container nav-inner">
    <a class="brand" href="/" aria-label="Octi Flow home">
      <img
        class="brand-logo"
        src="/assets/img/octi-flow-logo.png"
        alt="Octi Flow"
        width="552"
        height="218"
        decoding="async"
      />
    </a>

    <div class="desktop-menu">
      {
        navigationItems.map(({ href, label }) => (
          <a
            class="desktop-menu__link"
            href={href}
            aria-current={isCurrentPage(href) ? "page" : undefined}
          >
            {label}
          </a>
        ))
      }
    </div>

    <StoreBadges variant="header" />

    <button
      class="mobile-menu-toggle"
      type="button"
      aria-controls="mobile-navigation"
      aria-expanded="false"
      aria-label="Open menu"
    >
      <span></span>
      <span></span>
      <span></span>
    </button>
  </div>

  <div class="mobile-menu" id="mobile-navigation" hidden>
    <div class="container mobile-menu__inner">
      {
        navigationItems.map(({ href, label }) => (
          <a href={href} aria-current={isCurrentPage(href) ? "page" : undefined}>
            {label}
          </a>
        ))
      }
    </div>
  </div>
</nav>
