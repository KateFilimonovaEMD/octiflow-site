---
import type { BlogPost } from "../../utils/blog";
import {
  formatDate,
  postUrl,
  readingTime,
  topicSlug,
  topicUrl,
} from "../../utils/blog";

interface Props {
  post: BlogPost;
  featured?: boolean;
}

const { post, featured = false } = Astro.props;
const categorySlug = topicSlug(post.data.category);
---

<article
  class:list={[
    "article-card",
    { "article-card--featured": featured },
  ]}
  data-topic={categorySlug}
>
  {
    post.data.image ? (
      <a
        class="article-card__media"
        href={postUrl(post)}
        tabindex="-1"
        aria-hidden="true"
      >
        <picture>
          {post.data.imageAvif && <source srcset={post.data.imageAvif} type="image/avif" />}
          {post.data.imageWebp && <source srcset={post.data.imageWebp} type="image/webp" />}
          <img
            src={post.data.image}
            alt=""
            width={post.data.imageWidth ?? 1200}
            height={post.data.imageHeight ?? 800}
            loading={featured ? "eager" : "lazy"}
            decoding="async"
          />
        </picture>
      </a>
    ) : (
      <a
        class="article-card__media article-card__media--placeholder"
        href={postUrl(post)}
        tabindex="-1"
        aria-hidden="true"
      >
        <span class="article-card__placeholder-orb">
          {categorySlug === "habits-and-tracking" ? (
            <svg viewBox="0 0 64 64" aria-hidden="true">
              <path d="M32 10a22 22 0 1 0 18.2 9.65l-5.8 4.36A15 15 0 1 1 32 17v7l15-10-15-10v6Z" />
            </svg>
          ) : categorySlug === "health-and-safety" ? (
            <svg viewBox="0 0 64 64" aria-hidden="true">
              <path d="M26 8h12v18h18v12H38v18H26V38H8V26h18V8Z" />
            </svg>
          ) : categorySlug === "exercise-and-environment" ? (
            <svg viewBox="0 0 64 64" aria-hidden="true">
              <path d="M32 15a17 17 0 1 0 0 34 17 17 0 0 0 0-34Zm0-11h4v7h-4V4Zm0 49h4v7h-4v-7ZM4 30h7v4H4v-4Zm49 0h7v4h-7v-4ZM11.2 9.8l5 5-2.8 2.8-5-5 2.8-2.8Zm37.4 37.4 5 5-2.8 2.8-5-5 2.8-2.8Zm2.2-37.4 2.8 2.8-5 5-2.8-2.8 5-5ZM13.4 46.4l2.8 2.8-5 5-2.8-2.8 5-5Z" />
            </svg>
          ) : categorySlug === "sleep-and-wellness" ? (
            <svg viewBox="0 0 64 64" aria-hidden="true">
              <path d="M46.5 43.5A22 22 0 0 1 24 17a22 22 0 1 0 22.5 26.5Z" />
            </svg>
          ) : (
            <svg viewBox="0 0 64 64" aria-hidden="true">
              <path d="M32 5C25 17 15 28 15 40a17 17 0 0 0 34 0C49 28 39 17 32 5Z" />
            </svg>
          )}
        </span>
        <span class="article-card__placeholder-glow" aria-hidden="true"></span>
      </a>
    )
  }

  <div class="article-card__body">
    <div class="article-meta">
      <a class="article-meta__topic" href={topicUrl(post.data.category)}>
        {post.data.category}
      </a>
      <span aria-hidden="true">·</span>
      <time datetime={post.data.publishDate.toISOString()}>
        {formatDate(post.data.publishDate)}
      </time>
      <span aria-hidden="true">·</span>
      <span>{readingTime(post.body)} min read</span>
    </div>
    <h2>
      <a href={postUrl(post)}>{post.data.title}</a>
    </h2>
    <p>{post.data.description}</p>
    <a class="text-link article-card__link" href={postUrl(post)}>
      Read article…
    </a>
  </div>
</article>
