---
import type { BlogPost } from "../../utils/blog";
import { formatDate, postUrl, readingTime } from "../../utils/blog";

interface Props {
  post: BlogPost;
  featured?: boolean;
}

const { post, featured = false } = Astro.props;
---

<article class:list={["article-card", { "article-card--featured": featured }]}>
  {
    post.data.image ? (
      <a class="article-card__media" href={postUrl(post)} tabindex="-1" aria-hidden="true">
        <picture>
          {post.data.imageAvif && <source srcset={post.data.imageAvif} type="image/avif" />}
          {post.data.imageWebp && <source srcset={post.data.imageWebp} type="image/webp" />}
          <img
            src={post.data.image}
            alt=""
            width={post.data.imageWidth ?? 1200}
            height={post.data.imageHeight ?? 800}
            loading={featured ? "eager" : "lazy"}
            decoding="async"
          />
        </picture>
      </a>
    ) : (
      <div class="article-card__media article-card__media--placeholder" aria-hidden="true">
        <span>Octi Flow</span>
      </div>
    )
  }

  <div class="article-card__body">
    <div class="article-meta">
      <span>{post.data.category}</span>
      <span aria-hidden="true">·</span>
      <time datetime={post.data.publishDate.toISOString()}>
        {formatDate(post.data.publishDate)}
      </time>
      <span aria-hidden="true">·</span>
      <span>{readingTime(post.body)} min read</span>
    </div>
    <h2>
      <a href={postUrl(post)}>{post.data.title}</a>
    </h2>
    <p>{post.data.description}</p>
    <a class="text-link article-card__link" href={postUrl(post)}>
      Read article <span aria-hidden="true">→</span>
    </a>
  </div>
</article>
