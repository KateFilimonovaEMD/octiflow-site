---
import type { BlogPost } from "../../utils/blog";
import { formatDate, postUrl, readingTime } from "../../utils/blog";

interface Props {
  post: BlogPost;
  featured?: boolean;
}

const { post, featured = false } = Astro.props;
---

<article class:list={["article-card", { "article-card--featured": featured }]}>
  {
    post.data.image ? (
      <a class="article-card__media" href={postUrl(post)} tabindex="-1" aria-hidden="true">
        <img
          src={post.data.image}
          alt=""
          width="1200"
          height="675"
          loading={featured ? "eager" : "lazy"}
          decoding="async"
        />
      </a>
    ) : (
      <div class="article-card__media article-card__media--placeholder" aria-hidden="true">
        <span>Octi Flow</span>
      </div>
    )
  }

  <div class="article-card__body">
    <div class="article-meta">
      <span>{post.data.category}</span>
      <span aria-hidden="true">·</span>
      <time datetime={post.data.publishDate.toISOString()}>
        {formatDate(post.data.publishDate)}
      </time>
      <span aria-hidden="true">·</span>
      <span>{readingTime(post.body)} min read</span>
    </div>
    <h2>
      <a href={postUrl(post)}>{post.data.title}</a>
    </h2>
    <p>{post.data.description}</p>
    <a class="text-link article-card__link" href={postUrl(post)}>
      Read article <span aria-hidden="true">→</span>
    </a>
  </div>
</article>
