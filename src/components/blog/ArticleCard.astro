---
import type { BlogPost } from "../../utils/blog";
import { postUrl, readingTime, topicSlug } from "../../utils/blog";

interface Props {
  post: BlogPost;
  variant?: "tile" | "row";
}

const { post, variant = "tile" } = Astro.props;
const categorySlug = topicSlug(post.data.category);
const url = postUrl(post);
const hasImage = Boolean(post.data.image);
const baseClass = "article-card";
const variantClass = variant === "row" ? "article-card--row" : "article-card--tile";
---

<article class={`${baseClass} ${variantClass}`} data-topic={categorySlug}>
  <a class="article-card__link" href={url}>
    <div class="article-card__media">
      {
        hasImage ? (
          <picture>
            {post.data.imageAvif && <source srcset={post.data.imageAvif} type="image/avif" />}
            {post.data.imageWebp && <source srcset={post.data.imageWebp} type="image/webp" />}
            <img
              src={post.data.image}
              alt={post.data.imageAlt ?? ""}
              width={post.data.imageWidth}
              height={post.data.imageHeight}
              loading="lazy"
              decoding="async"
            />
          </picture>
        ) : (
          <span class="article-cover-placeholder" aria-hidden="true">
            <span>Cover image coming soon</span>
          </span>
        )
      }
      {variant === "row" && (
        <div class="article-card__media-overlay">
          <h3 class="article-card__title article-card__title--overlay">{post.data.title}</h3>
        </div>
      )}
    </div>

    <div class="article-card__body">
      <div>
        <div class="article-card__meta"><span>{post.data.category}</span></div>

        {variant !== "row" && <h3 class="article-card__title">{post.data.title}</h3>}
        <p class="article-card__description">{post.data.description}</p>
      </div>

      <div class="article-card__footer">
        <span class="article-card__reading-time">{readingTime(post.body)} min read</span>
        <span class="article-card__cta" aria-hidden="true">
          <span class="article-card__arrow"></span>
        </span>
      </div>
    </div>
  </a>
</article>
