---
import { getCollection, render } from "astro:content";
import ArticleLayout from "../../layouts/ArticleLayout.astro";
import { isPublished, sortPosts } from "../../utils/blog";

export async function getStaticPaths() {
  const allPosts = await getCollection("blog");
  const publishedPosts = sortPosts(allPosts.filter(isPublished));

  return publishedPosts.map((post) => {
    const explicitlyRelated = post.data.related
      .map((id) => publishedPosts.find((candidate) => candidate.id === id))
      .filter((candidate): candidate is (typeof publishedPosts)[number] => Boolean(candidate));

    const explicitIds = new Set(explicitlyRelated.map((candidate) => candidate.id));
    const postTags = new Set(post.data.tags.map((tag) => tag.toLowerCase()));

    const fallbackRelated = publishedPosts
      .filter(
        (candidate) =>
          candidate.id !== post.id &&
          !explicitIds.has(candidate.id),
      )
      .map((candidate) => {
        const sharedTags = candidate.data.tags.reduce(
          (count, tag) => count + (postTags.has(tag.toLowerCase()) ? 1 : 0),
          0,
        );
        const sameCategory = candidate.data.category === post.data.category;

        return {
          candidate,
          score: (sameCategory ? 4 : 0) + sharedTags,
        };
      })
      .filter(({ score }) => score > 0)
      .sort(
        (a, b) =>
          b.score - a.score ||
          b.candidate.data.publishDate.getTime() - a.candidate.data.publishDate.getTime(),
      )
      .map(({ candidate }) => candidate);

    return {
      params: { id: post.id },
      props: {
        post,
        relatedPosts: [...explicitlyRelated, ...fallbackRelated].slice(0, 3),
      },
    };
  });
}

const { post, relatedPosts } = Astro.props;
const { Content, headings } = await render(post);
---

<ArticleLayout {post} {relatedPosts} {headings}>
  <Content />
</ArticleLayout>
