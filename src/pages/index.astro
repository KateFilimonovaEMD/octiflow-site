---
import BaseLayout from "../layouts/BaseLayout.astro";

const canonical = "https://octiflow.app/";
const appStoreUrl =
  "https://apps.apple.com/app/octi-flow/id6783334530";

const structuredData = {
  "@type": "WebPage",
  "@id": `${canonical}#webpage`,
  url: canonical,
  name: "Octi Flow - Hydration Tracker & Water Reminder App",
  description:
    "Build a more sustainable hydration habit with gentle reminders, simple water tracking, streaks, achievements, and an animated companion.",
  about: {
    "@id": "https://octiflow.app/#app",
  },
  publisher: {
    "@id": "https://octiflow.app/#organization",
  },
};
---

<BaseLayout
  title="Octi Flow - Hydration Tracker & Water Reminder App"
  description="Build a more sustainable hydration habit with gentle reminders, simple water tracking, streaks, achievements, and an animated companion."
  {canonical}
  imageAlt="Octi, the animated companion from the Octi Flow hydration tracker app"
  {structuredData}
>
  <main>
    <section class="product-hero">
      <div class="container product-hero-grid">
        <div class="product-hero-copy">
          <p class="product-kicker">Meet Octi Flow</p>

          <h1>A companion for your hydration habit.</h1>

          <p class="product-lead">
            Drinking water is simple. Remembering to do it every day is harder.
            Octi Flow makes the routine feel more supportive, rewarding, and
            easier to return to, one glass at a time.
          </p>

          <div class="product-actions">
            <a
              class="product-button product-button-primary"
              href={appStoreUrl}
              target="_blank"
              rel="noopener noreferrer"
            >
              Download on the App Store
            </a>

            <a class="product-button product-button-secondary" href="#how-it-works">
              See how it works
            </a>
          </div>

          <p class="product-note">
            Free to download. Optional in-app purchases available. Designed for
            general wellness, not medical advice.
          </p>
        </div>

        <div class="product-hero-visual" aria-hidden="true">
          <div class="flow-orbit flow-orbit-one"></div>
          <div class="flow-orbit flow-orbit-two"></div>

          <div class="flow-phone">
            <div class="flow-phone-speaker"></div>

            <div class="flow-phone-screen">
              <div class="flow-screen-top">
                <span>Today</span>
                <span>•••</span>
              </div>

              <div class="flow-drop">
                <div class="flow-drop-inner"></div>
              </div>

              <strong>A fresh start.</strong>

              <span class="flow-screen-copy">
                One glass at a time. Octi is with you.
              </span>

              <div class="flow-progress">
                <span></span>
              </div>

              <div class="flow-screen-bottom">
                <span>250 ml</span>
                <span>2,500 ml goal</span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="product-section product-belief">
      <div class="container">
        <div class="product-belief-copy">
          <p class="product-kicker">More than tracking</p>

          <h2>Tracking measures progress. Companionship helps sustain it.</h2>

          <p>
            Most hydration apps focus on numbers and generic reminders. Octi
            Flow is designed around the part that matters after the first day:
            helping you want to come back.
          </p>
        </div>

        <div class="product-comparison">
          <div class="product-comparison-card product-comparison-muted">
            <span>Traditional trackers</span>
            <strong>Log water.</strong>
            <p>Numbers, generic reminders, and utility-first tracking.</p>
          </div>

          <div class="product-comparison-card">
            <span>Octi Flow</span>
            <strong>Build a habit with Octi.</strong>
            <p>
              Supportive messages, visible progress, positive rewards, and a
              companion that grows with you.
            </p>
          </div>
        </div>
      </div>
    </section>

    <section class="product-section product-section-soft" id="how-it-works">
      <div class="container">
        <div class="product-section-heading">
          <p class="product-kicker">A habit you can return to</p>

          <h2>Small actions, made more rewarding.</h2>

          <p>
            Octi Flow turns a simple daily goal into a more encouraging routine,
            without making the experience feel demanding or complicated.
          </p>
        </div>

        <div class="product-feature-grid">
          <article class="product-feature-card">
            <div class="product-feature-number">01</div>
            <h3>Set your daily flow</h3>
            <p>
              Start with a clear daily hydration goal that gives your routine a
              simple direction.
            </p>
          </article>

          <article class="product-feature-card">
            <div class="product-feature-number">02</div>
            <h3>Stay gently on track</h3>
            <p>
              Friendly reminders help bring the habit back to mind during busy
              days, without adding pressure.
            </p>
          </article>

          <article class="product-feature-card">
            <div class="product-feature-number">03</div>
            <h3>See progress. Earn rewards.</h3>
            <p>
              Follow your progress, build streaks, unlock achievements, and
              share the small wins with Octi.
            </p>
          </article>
        </div>
      </div>
    </section>

    <section class="product-section">
      <div class="container product-split">
        <div>
          <p class="product-kicker">Your daily companion</p>

          <h2>Meet Octi.</h2>

          <p>
            Octi is not just an icon in the corner. Your animated octopus
            companion reacts to your progress, celebrates each step, and makes
            the routine feel a little more personal.
          </p>

          <p>
            The goal is not to make hydration feel like work. It is to make a
            small healthy action feel worth coming back to.
          </p>
        </div>

        <div class="product-octi-card">
          <span class="product-octi-bubble">
            A fresh start.<br />
            One glass at a time.
          </span>

          <div class="product-octi-mark" aria-hidden="true">
            <span></span>
            <span></span>
            <span></span>
          </div>

          <strong>Octi is with you.</strong>
        </div>
      </div>
    </section>

    <section class="product-section product-section-soft">
      <div class="container product-split">
        <div class="product-premium-card">
          <span class="product-premium-label">Octi Premium</span>

          <h3>Make Octi truly yours.</h3>

          <p>
            Unlock companion personalization, premium themes, accessories,
            exclusive skins, and more achievements.
          </p>
        </div>

        <div>
          <p class="product-kicker">Free at the core</p>

          <h2>Healthy habits should not depend on a subscription.</h2>

          <p>
            The tools you need to build your daily hydration habit remain free:
            unlimited tracking, smart reminders, streaks, and companion rewards.
          </p>

          <p>
            Premium supports the growing Octi ecosystem while giving you more
            ways to personalize the companion you build a connection with.
          </p>

          <a class="product-text-link" href="/terms/">
            Read about Premium
            <span aria-hidden="true">→</span>
          </a>
        </div>
      </div>
    </section>

    <section class="product-section">
      <div class="container">
        <div class="product-section-heading">
          <p class="product-kicker">Explore Octi Flow</p>

          <h2>Guidance and clear information, whenever you need it.</h2>

          <p>
            Read practical hydration guides, learn about the independent studio
            behind Octi Flow, or find product support and policies.
          </p>
        </div>

        <div class="product-links-grid">
          <a class="product-link-card" href="/blog/">
            <span class="product-link-label">Blog</span>
            <strong>Read practical hydration guides</strong>
            <span aria-hidden="true">→</span>
          </a>

          <a class="product-link-card" href="/about/">
            <span class="product-link-label">About</span>
            <strong>Meet EvaMariaDreams</strong>
            <span aria-hidden="true">→</span>
          </a>

          <a class="product-link-card" href="/support/">
            <span class="product-link-label">Support</span>
            <strong>Get help with Octi Flow</strong>
            <span aria-hidden="true">→</span>
          </a>

          <a class="product-link-card" href="/privacy/">
            <span class="product-link-label">Privacy</span>
            <strong>Read the Privacy Policy</strong>
            <span aria-hidden="true">→</span>
          </a>
        </div>
      </div>
    </section>

    <section class="product-cta">
      <div class="container">
        <div class="product-cta-card">
          <div>
            <p class="product-kicker">Start today</p>
            <h2>Stay hydrated. Grow together with Octi.</h2>
          </div>

          <a
            class="product-button product-button-light"
            href={appStoreUrl}
            target="_blank"
            rel="noopener noreferrer"
          >
            Download on the App Store
          </a>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>
