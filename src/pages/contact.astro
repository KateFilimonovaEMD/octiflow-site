---
import ContentLayout from "../layouts/ContentLayout.astro";

const tocItems: { href: string; label: string }[] = [];
---

<ContentLayout
  title="Contact EvaMariaDreams - Business, Press & Product Support"
  description="Contact EvaMariaDreams for business, press, founder, product support, and privacy inquiries."
  canonical="https://octiflow.app/contact/"
  heroTitle="Contact EvaMariaDreams"
  heroDescription="Questions, partnerships, media inquiries, or help with our products."
  tocLabel="Contact channels"
  {tocItems}
>
  <section
    class="card card--brand contact-directory"
    aria-label="Contact channels"
  >
    <div class="contact-directory-item">
      <h2>Business</h2>
      <p>Partnerships, collaborations, and studio-related opportunities.</p>
      <a
        class="text-link text-link--inverse"
        href="mailto:business@evamariadreams.com"
      >
        business@<wbr />evamariadreams.com
      </a>
    </div>

    <div class="contact-directory-item">
      <h2>Press</h2>
      <p>
        Media requests, interviews, creator outreach, and press-related
        inquiries.
      </p>
      <a
        class="text-link text-link--inverse"
        href="mailto:press@evamariadreams.com"
      >
        press@<wbr />evamariadreams.com
      </a>
    </div>

    <div class="contact-directory-item">
      <h2>Founder</h2>
      <p>Direct founder-level contact for select conversations.</p>
      <a
        class="text-link text-link--inverse"
        href="mailto:founder@evamariadreams.com"
      >
        founder@<wbr />evamariadreams.com
      </a>
    </div>

    <div class="contact-directory-item">
      <h2>Product support</h2>
      <p>
        For help with Octi Flow, purchases, refunds, subscriptions, or
        product-related questions.
      </p>
      <a class="text-link text-link--inverse" href="/support/">
        Visit Octi Flow Support
      </a>
    </div>

    <div class="contact-directory-item">
      <h2>Privacy</h2>
      <p>
        For privacy-related questions or requests regarding the Privacy Policy.
      </p>
      <a class="text-link text-link--inverse" href="/privacy/#contact">
        View privacy contact information
      </a>
    </div>
  </section>
</ContentLayout>
