---
import ContentLayout from "../layouts/ContentLayout.astro";

const tocItems = [
  { href: "#overview", label: "Overview" },
  { href: "#accounts", label: "Accounts" },
  {
    href: "#information-you-provide",
    label: "Information you provide in the app",
  },
  { href: "#local-processing", label: "Local processing" },
  { href: "#notifications", label: "Notifications" },
  {
    href: "#purchases-and-premium-features",
    label: "Purchases and premium features",
  },
  {
    href: "#analytics-and-third-party-services",
    label: "Analytics and third-party services",
  },
  {
    href: "#health-data-and-integrations",
    label: "Health data and integrations",
  },
  { href: "#support-communications", label: "Support communications" },
  { href: "#data-retention", label: "Data retention" },
  { href: "#childrens-privacy", label: "Children’s privacy" },
  { href: "#changes-to-this-policy", label: "Changes to this policy" },
  { href: "#contact", label: "Contact" },
];
---

<ContentLayout
  title="Privacy Policy — Octi Flow"
  description="Privacy Policy for Octi Flow by EvaMariaDreams."
  canonical="https://octiflow.app/privacy"
  heroTitle="Privacy Policy"
  heroDescription="This Privacy Policy explains how information may be handled in connection with the Octi Flow app and the EvaMariaDreams website."
  tocLabel="Privacy Policy sections"
  {tocItems}
>
  <section class="reveal" id="overview">
    <h2>Overview</h2>
    <p>
      EvaMariaDreams respects your privacy. This Privacy Policy explains how
      information may be handled in connection with the Octi Flow app and the
      EvaMariaDreams website.
    </p>
  </section>

  <section class="reveal" id="accounts">
    <h2>Accounts</h2>
    <p>Octi Flow does not create user accounts at this time.</p>
  </section>

  <section class="reveal" id="information-you-provide">
    <h2>Information you provide in the app</h2>
    <p>
      Octi Flow may allow you to enter information such as age, weight,
      hydration-related preferences, and other app settings used to personalize
      your experience.
    </p>
    <p>
      This information is stored locally on your device and is not transmitted
      to EvaMariaDreams.
    </p>
  </section>

  <section class="reveal" id="local-processing">
    <h2>Local processing</h2>
    <p>
      Hydration-related calculations, reminders, and personalization features in
      Octi Flow are processed locally on your device. EvaMariaDreams does not
      receive this information through the app.
    </p>
  </section>

  <section class="reveal" id="notifications">
    <h2>Notifications</h2>
    <p>
      Notifications and reminders, if enabled, are scheduled locally on your
      device.
    </p>
  </section>

  <section class="reveal" id="purchases-and-premium-features">
    <h2>Purchases and premium features</h2>
    <p>
      Octi Flow may offer premium features through in-app purchases. Premium
      access may include expanded functionality and visual customization,
      including themes, backgrounds, and companion variations.
    </p>
    <p>
      Purchase transactions are processed by the platform provider through which
      the purchase was made and not directly by EvaMariaDreams.
    </p>
  </section>

  <section class="reveal" id="analytics-and-third-party-services">
    <h2>Analytics and third-party services</h2>
    <p>
      Octi Flow does not use third-party analytics, advertising SDKs, or
      external tracking services at this time.
    </p>
    <p>
      EvaMariaDreams does not sell personal information and does not share app
      profile data with third parties for advertising purposes.
    </p>
  </section>

  <section class="reveal" id="health-data-and-integrations">
    <h2>Health data and integrations</h2>
    <p>
      Octi Flow does not collect data from Apple Health or HealthKit and does
      not use third-party health-data integrations at this time.
    </p>
  </section>

  <section class="reveal" id="support-communications">
    <h2>Support communications</h2>
    <p>
      If you contact EvaMariaDreams by email, the information you provide in
      your message, including your email address and any details you choose to
      share, may be used to respond to your request and provide support.
    </p>
  </section>

  <section class="reveal" id="data-retention">
    <h2>Data retention</h2>
    <p>
      Information entered into the app remains on your device unless you remove
      it, delete the app, or reset your device settings. Support and privacy
      emails may be retained for a reasonable period for communication,
      recordkeeping, and support purposes.
    </p>
  </section>

  <section class="reveal" id="childrens-privacy">
    <h2>Children’s privacy</h2>
    <p>
      Octi Flow is not intended to knowingly collect personal information from
      children through external servers or third-party services. If you believe
      personal information has been provided to us directly by email in error,
      please contact us.
    </p>
  </section>

  <section class="reveal" id="changes-to-this-policy">
    <h2>Changes to this policy</h2>
    <p>
      This Privacy Policy may be updated from time to time. Any updated version
      will be published on this page with a revised effective date.
    </p>
  </section>

  <section class="reveal" id="contact">
    <h2>Contact</h2>

    <div class="card card--brand contact-card">
      <p>
        For privacy-related questions, please contact EvaMariaDreams at{" "}
        <a
          class="text-link text-link--inverse"
          href="mailto:privacy@evamariadreams.com">privacy@evamariadreams.com</a
        >
      </p>
    </div>
  </section>
  <span class="document-status">Last updated: May 24, 2026</span>
</ContentLayout>
