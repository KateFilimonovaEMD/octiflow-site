---
import BaseLayout from "../layouts/BaseLayout.astro";

const canonical = "https://octiflow.app/about/";
const instagramUrl = "https://www.instagram.com/evamariadreams/";

const structuredData = {
  "@type": "AboutPage",
  "@id": `${canonical}#webpage`,
  url: canonical,
  name: "Behind Octi Flow - Meet the Two-Person Team",
  description:
    "Meet the husband-and-wife indie team in Barcelona designing, building, animating, and growing Octi Flow in public.",
  about: {
    "@id": "https://octiflow.app/#organization",
  },
  mainEntity: {
    "@id": "https://octiflow.app/#app",
  },
};
---

<BaseLayout
  title="Behind Octi Flow - Meet the Two-Person Team"
  description="Meet the husband-and-wife indie team in Barcelona designing, building, animating, and growing Octi Flow in public."
  {canonical}
  imageAlt="The two-person team building Octi Flow"
  {structuredData}
>
  <main class="about-page">
    <section class="about-story-hero">
      <div class="container about-story-hero__grid">
        <div class="about-story-hero__copy">
          <p class="eyebrow eyebrow--section">Behind Octi Flow</p>

          <div class="about-live-status">
            <span aria-hidden="true"></span>
            Live on the App Store · Actively improving
          </div>

          <h1>Built by two people. Growing with every update.</h1>

          <p class="about-story-lead">
            We’re Kate and Eugene - a husband-and-wife indie team in
            Barcelona. We design, code, animate, and ship Octi Flow ourselves,
            sharing the process as it grows.
          </p>

          <div class="about-story-actions">
            <a
              class="button button--large button--primary"
              href="#building-in-public"
            >
              Follow the build
            </a>
          </div>
        </div>

        <div class="about-hero-visual">
          <div class="about-hero-photo-wrap">
            <figure class="about-hero-photo">
              <img
                src="/images/about/Team_Photo_01.webp"
                alt="Kate and Eugene working together on Octi Flow at a laptop"
                width="880"
                height="1203"
                loading="eager"
                fetchpriority="high"
                decoding="async"
              />
            </figure>

            <span class="about-skill-tag about-skill-tag--code">Code</span>
            <span class="about-skill-tag about-skill-tag--design">Design</span>
            <span class="about-skill-tag about-skill-tag--animation">Animation</span>
            <span class="about-skill-tag about-skill-tag--ios">iOS</span>
          </div>
        </div>
      </div>
    </section>

    <section class="about-story-section about-origin">
      <div class="container about-origin__grid">
        <div class="about-origin__copy">
          <p class="eyebrow eyebrow--section">How it started</p>
          <h2>It started with a simple question.</h2>
          <p class="about-origin__question">
            Could a hydration tracker feel less like a utility - and more like
            a companion?
          </p>
          <p>
            Most trackers already knew how to count water. We wanted to explore
            the part that comes after the first download: what makes someone
            want to return tomorrow? That question became Octi Flow.
          </p>
          <p>
            Every part of the app - from the Unity systems and interface to
            Octi’s character, animation, and iOS release - is shaped inside our
            two-person team.
          </p>
        </div>

        <div class="about-evolution" aria-label="Octi Flow then and now">
          <figure class="about-evolution-card about-evolution-card--early">
            <div class="about-evolution-card__media">
              <img
                src="/images/about/Dev_01.webp"
                alt="Pencil sketch of the first Octi Flow interface"
                width="609"
                height="1261"
                loading="lazy"
                decoding="async"
              />
            </div>
            <figcaption>
              <span>Then</span>
              <strong>The first working idea</strong>
            </figcaption>
          </figure>

          <span class="about-evolution-arrow" aria-hidden="true">
            <svg
              class="about-evolution-arrow__icon icon-stroke-centered"
              viewBox="0 0 16 16"
              focusable="false"
            >
              <path d="M3 8h10M9 4l4 4-4 4" />
            </svg>
          </span>

          <figure class="about-evolution-card about-evolution-card--today">
            <div class="about-evolution-card__media">
              <img
                src="/images/about/Dev_02.webp"
                alt="Final Octi Flow interface with Octi and hydration tracking"
                width="609"
                height="1261"
                loading="lazy"
                decoding="async"
              />
            </div>
            <figcaption>
              <span>Today</span>
              <strong>A companion on the App Store</strong>
            </figcaption>
          </figure>
        </div>
      </div>
    </section>

    <section class="about-story-section about-team-section">
      <div class="container">
        <div class="about-section-heading about-section-heading--center">
          <p class="eyebrow eyebrow--section">The people behind Octi</p>
          <h2>Two people. One shared vision.</h2>
          <p>
            Everything in Octi Flow, from the visuals and animation to the code
            and releases, is created by the two of us.
          </p>
        </div>

        <div class="about-team-grid">
          <article class="about-person-card">
            <figure class="about-person-card__portrait">
              <img
                src="/images/about/Kate_Personal_01.png"
                alt="Portrait of Kate Filimonova"
                width="866"
                height="586"
                loading="lazy"
                decoding="async"
              />
            </figure>
            <div class="about-person-card__body">
              <span class="about-person-card__role">
                Co-founder · Unity developer &amp; product lead
              </span>
              <div class="about-person-card__heading">
                <h3>Kate Filimonova</h3>
                <a
                  class="about-person-card__linkedin"
                  href="https://www.linkedin.com/in/kate-filimonova/"
                  target="_blank"
                  rel="me noopener noreferrer"
                  aria-label="Kate Filimonova on LinkedIn"
                >
                  <svg
                    width="40"
                    height="40"
                    viewBox="0 0 24 24"
                    aria-hidden="true"
                    focusable="false"
                  >
                    <defs>
                      <linearGradient
                        id="about-linkedin-gradient-kate"
                        x1="2"
                        y1="2"
                        x2="22"
                        y2="22"
                        gradientUnits="userSpaceOnUse"
                      >
                        <stop offset="0" stop-color="#073080" />
                        <stop offset="0.58" stop-color="#015cc6" />
                        <stop offset="1" stop-color="#5db7ff" />
                      </linearGradient>
                    </defs>
                    <path
                      d="M20.45 20.45h-3.56v-5.57c0-1.33-.02-3.04-1.85-3.04-1.85 0-2.14 1.45-2.14 2.94v5.67H9.34V9h3.42v1.56h.05c.48-.9 1.64-1.85 3.37-1.85 3.61 0 4.27 2.37 4.27 5.46v6.28ZM5.32 7.43a2.06 2.06 0 1 1 0-4.12 2.06 2.06 0 0 1 0 4.12ZM7.1 20.45H3.54V9H7.1v11.45Z"
                      fill="url(#about-linkedin-gradient-kate)"
                    />
                  </svg>
                </a>
              </div>
              <p>
                Kate builds Octi Flow in Unity, from its core systems and
                interface to testing and release.
              </p>
              <p class="about-person-card__focus">
                <strong>Her focus:</strong> turning complex features into simple,
                reliable interactions.
              </p>
            </div>
          </article>

          <article class="about-person-card">
            <figure class="about-person-card__portrait">
              <img
                src="/images/about/Eugene_Personal_01.png"
                alt="Portrait of Eugene Filimonov"
                width="866"
                height="586"
                loading="lazy"
                decoding="async"
              />
            </figure>
            <div class="about-person-card__body">
              <span class="about-person-card__role">
                Co-founder · Product designer &amp; animator
              </span>
              <div class="about-person-card__heading">
                <h3>Eugene Filimonov</h3>
                <a
                  class="about-person-card__linkedin"
                  href="https://www.linkedin.com/in/eugenefil/"
                  target="_blank"
                  rel="me noopener noreferrer"
                  aria-label="Eugene Filimonov on LinkedIn"
                >
                  <svg
                    width="40"
                    height="40"
                    viewBox="0 0 24 24"
                    aria-hidden="true"
                    focusable="false"
                  >
                    <defs>
                      <linearGradient
                        id="about-linkedin-gradient-eugene"
                        x1="2"
                        y1="2"
                        x2="22"
                        y2="22"
                        gradientUnits="userSpaceOnUse"
                      >
                        <stop offset="0" stop-color="#073080" />
                        <stop offset="0.58" stop-color="#015cc6" />
                        <stop offset="1" stop-color="#5db7ff" />
                      </linearGradient>
                    </defs>
                    <path
                      d="M20.45 20.45h-3.56v-5.57c0-1.33-.02-3.04-1.85-3.04-1.85 0-2.14 1.45-2.14 2.94v5.67H9.34V9h3.42v1.56h.05c.48-.9 1.64-1.85 3.37-1.85 3.61 0 4.27 2.37 4.27 5.46v6.28ZM5.32 7.43a2.06 2.06 0 1 1 0-4.12 2.06 2.06 0 0 1 0 4.12ZM7.1 20.45H3.54V9H7.1v11.45Z"
                      fill="url(#about-linkedin-gradient-eugene)"
                    />
                  </svg>
                </a>
              </div>
              <p>
                Eugene shapes Octi’s look, movement, and personality, creating
                a companion that feels expressive and alive.
              </p>
              <p class="about-person-card__focus">
                <strong>His focus:</strong> making every interaction clear,
                engaging, and full of character.
              </p>
            </div>
          </article>
        </div>
      </div>
    </section>

    <section class="about-build" id="building-in-public">
      <div class="container">
        <div class="about-build__intro">
          <div>
            <p class="eyebrow eyebrow--light about-build__kicker">Octi Flow, now and next</p>
            <h2>Octi Flow is live. And we are still improving it.</h2>
          </div>
          <p>
            Octi Flow is already available on the App Store. We keep making it
            better based on real feedback and what we learn from everyday use.
          </p>
        </div>

        <div class="about-build-status">
          <article>
            <span class="about-build-status__number">01</span>
            <p class="about-build-status__label">Available now</p>
            <h3>Octi Flow for iPhone</h3>
            <p>
              Track your water, set reminders, keep your streak going, earn
              achievements, and watch Octi react to your progress.
            </p>
          </article>

          <article class="about-build-status__active">
            <span class="about-build-status__number">02</span>
            <p class="about-build-status__label">
              <span aria-hidden="true"></span>
              Improving now
            </p>
            <h3>A smoother everyday experience</h3>
            <p>
              We are refining the controls, animations, and small details that
              make logging water feel quick, clear, and rewarding.
            </p>
          </article>

          <article>
            <span class="about-build-status__number">03</span>
            <p class="about-build-status__label">Exploring next</p>
            <h3>More ways to make Octi yours</h3>
            <p>
              We are exploring new reactions and customization options that
              could make Octi feel even more personal.
            </p>
          </article>
        </div>

        <p class="about-build__updated">Updated August 2026</p>
      </div>
    </section>

    <section class="about-story-section about-moments">
      <div class="container">
        <div class="about-section-heading">
          <p class="eyebrow eyebrow--section">Behind the details</p>
          <h2>A closer look at how Octi Flow is made.</h2>
          <p>
            Two small parts of the app that took a lot of testing, iteration,
            and care.
          </p>
        </div>

        <div class="about-moments-grid">
          <article class="about-moment-card">
            <div class="about-moment-media about-moment-media--video">
              <video
                class="about-moment-video"
                autoplay
                muted
                loop
                playsinline
                preload="metadata"
                poster="/images/about/one-handed-water-logging-poster.webp"
                aria-label="One-handed water logging in Octi Flow: choosing a portion, adding water, updating progress, and seeing Octi react"
              >
                <source
                  src="/videos/about/one-handed-water-logging.mp4"
                  type="video/mp4"
                />
                Your browser does not support embedded video.
              </video>
            </div>
            <div class="about-moment-card__body">
              <span>Interface design</span>
              <h3>Making water logging easier with one hand</h3>
              <p>
                We tested several layouts before choosing controls that feel
                quick, clear, and comfortable in daily use.
              </p>
            </div>
          </article>

          <article class="about-moment-card">
            <div class="about-moment-media about-moment-media--video">
              <video
                class="about-moment-video"
                autoplay
                muted
                loop
                playsinline
                preload="metadata"
                poster="/images/about/octi-reaction-process-poster.webp"
                aria-label="Octi reaction shown in Spine animation software and in the finished Octi Flow app"
              >
                <source
                  src="/videos/about/octi-reaction-process.mp4"
                  type="video/mp4"
                />
                Your browser does not support embedded video.
              </video>
            </div>
            <div class="about-moment-card__body">
              <span>Character animation</span>
              <h3>How Octi reacts to your progress</h3>
              <p>
                Pose, timing, and expression turn a short animation into
                feedback that feels encouraging and alive.
              </p>
            </div>
          </article>
        </div>
      </div>
    </section>

    <section class="about-follow">
      <div class="container">
        <div class="about-follow__card">
          <p class="eyebrow eyebrow--light about-follow__kicker">Follow the real build</p>
          <h2>Watch Octi Flow grow with us.</h2>
          <p>
            New features, animation experiments, design decisions, mistakes,
            and small wins - shared by the two people building it.
          </p>
          <div class="about-follow__actions">
            <a
              class="button button--large button--light"
              href={instagramUrl}
              target="_blank"
              rel="noopener noreferrer"
            >
              See the latest updates
            </a>
            <a class="action-link action-link--inverse about-follow__text-link" href="/contact/">
              <span>Talk to the team</span>
              <svg
                class="about-follow__link-icon"
                viewBox="0 0 16 16"
                aria-hidden="true"
                focusable="false"
              >
                <path d="M3 8h10M9 4l4 4-4 4" />
              </svg>
            </a>
          </div>
          <p class="about-follow__note">
            Or choose your favorite platform in the social links below.
          </p>
        </div>
      </div>
    </section>
  </main>

</BaseLayout>
