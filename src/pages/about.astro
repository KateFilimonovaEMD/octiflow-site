---
import BaseLayout from "../layouts/BaseLayout.astro";

const canonical = "https://octiflow.app/about/";
const appStoreUrl = "https://apps.apple.com/app/octi-flow/id6783334530";
const instagramUrl = "https://www.instagram.com/evamariadreams/";

const structuredData = {
  "@type": "AboutPage",
  "@id": `${canonical}#webpage`,
  url: canonical,
  name: "Behind Octi Flow - Meet the Two-Person Team",
  description:
    "Meet the husband-and-wife indie team in Barcelona designing, building, animating, and growing Octi Flow in public.",
  about: {
    "@id": "https://octiflow.app/#organization",
  },
  mainEntity: {
    "@id": "https://octiflow.app/#app",
  },
};
---

<BaseLayout
  title="Behind Octi Flow - Meet the Two-Person Team"
  description="Meet the husband-and-wife indie team in Barcelona designing, building, animating, and growing Octi Flow in public."
  {canonical}
  imageAlt="The two-person team building Octi Flow"
  {structuredData}
>
  <main class="about-page">
    <section class="about-story-hero">
      <div class="container about-story-hero__grid">
        <div class="about-story-hero__copy">
          <p class="product-kicker">Behind Octi Flow</p>

          <div class="about-live-status">
            <span aria-hidden="true"></span>
            Live on the App Store · Actively improving
          </div>

          <h1>Built by two people. Growing with every update.</h1>

          <p class="about-story-lead">
            We’re Kate and Eugene - a husband-and-wife indie team in
            Barcelona. We design, code, animate, and ship Octi Flow ourselves,
            sharing the process as it grows.
          </p>

          <div class="about-story-actions">
            <a
              class="product-button product-button-primary"
              href="#building-in-public"
            >
              Follow the build
            </a>
            <a
              class="product-button product-button-secondary"
              href={appStoreUrl}
              target="_blank"
              rel="noopener noreferrer"
            >
              Get Octi Flow
            </a>
          </div>
        </div>

        <div class="about-hero-visual">
          <figure class="about-hero-photo">
            <img
              src="/images/about/Team_Photo_01.webp"
              alt="Kate and Eugene working together on Octi Flow at a laptop"
              width="880"
              height="1203"
              loading="eager"
              fetchpriority="high"
              decoding="async"
            />
          </figure>

          <span class="about-skill-tag about-skill-tag--code">Code</span>
          <span class="about-skill-tag about-skill-tag--design">Design</span>
          <span class="about-skill-tag about-skill-tag--animation">Animation</span>
          <span class="about-skill-tag about-skill-tag--ios">iOS</span>
        </div>
      </div>
    </section>

    <section class="about-story-section about-origin">
      <div class="container about-origin__grid">
        <div class="about-origin__copy">
          <p class="product-kicker">How it started</p>
          <h2>It started with a simple question.</h2>
          <p class="about-origin__question">
            Could a hydration tracker feel less like a utility - and more like
            a companion?
          </p>
          <p>
            Most trackers already knew how to count water. We wanted to explore
            the part that comes after the first download: what makes someone
            want to return tomorrow? That question became Octi Flow.
          </p>
          <p>
            Every part of the app - from the Unity systems and interface to
            Octi’s character, animation, and iOS release - is shaped inside our
            two-person team.
          </p>
        </div>

        <div class="about-evolution" aria-label="Octi Flow then and now">
          <figure class="about-evolution-card about-evolution-card--early">
            <div
              class="about-media-placeholder"
              role="img"
              aria-label="Placeholder for an early Octi Flow prototype"
            >
              <div class="about-placeholder-icon" aria-hidden="true">
                <span></span>
              </div>
              <small>Early prototype image</small>
            </div>
            <figcaption>
              <span>Then</span>
              <strong>The first working idea</strong>
            </figcaption>
          </figure>

          <span class="about-evolution-arrow" aria-hidden="true">
            <svg
              class="about-evolution-arrow__icon"
              viewBox="0 0 16 16"
              focusable="false"
            >
              <path d="M3 8h10M9 4l4 4-4 4" />
            </svg>
          </span>

          <figure class="about-evolution-card about-evolution-card--today">
            <div
              class="about-media-placeholder"
              role="img"
              aria-label="Placeholder for the current Octi Flow app"
            >
              <div class="about-placeholder-icon" aria-hidden="true">
                <span></span>
              </div>
              <small>Current app image</small>
            </div>
            <figcaption>
              <span>Today</span>
              <strong>A companion on the App Store</strong>
            </figcaption>
          </figure>
        </div>
      </div>
    </section>

    <section class="about-story-section about-team-section">
      <div class="container">
        <div class="about-section-heading about-section-heading--center">
          <p class="product-kicker">The people behind Octi</p>
          <h2>Two disciplines. One shared product.</h2>
          <p>
            Small by design means the people making the decisions are also the
            people drawing, building, testing, and shipping them.
          </p>
        </div>

        <div class="about-team-grid">
          <article class="about-person-card">
            <figure class="about-person-card__portrait">
              <img
                src="/images/about/Kate_Personal_01.png"
                alt="Portrait of Kate Filimonova"
                width="866"
                height="586"
                loading="lazy"
                decoding="async"
              />
            </figure>
            <div class="about-person-card__body">
              <span class="about-person-card__role">
                Co-founder · Unity development &amp; product strategy
              </span>
              <div class="about-person-card__heading">
                <h3>Kate Filimonova</h3>
                <a
                  class="about-person-card__linkedin"
                  href="https://www.linkedin.com/in/kate-filimonova/"
                  target="_blank"
                  rel="me noopener noreferrer"
                  aria-label="Kate Filimonova on LinkedIn"
                >
                  <svg
                    viewBox="0 0 24 24"
                    aria-hidden="true"
                    focusable="false"
                  >
                    <path d="M20.45 20.45h-3.56v-5.57c0-1.33-.02-3.04-1.85-3.04-1.85 0-2.14 1.45-2.14 2.94v5.67H9.34V9h3.42v1.56h.05c.48-.9 1.64-1.85 3.37-1.85 3.61 0 4.27 2.37 4.27 5.46v6.28ZM5.32 7.43a2.06 2.06 0 1 1 0-4.12 2.06 2.06 0 0 1 0 4.12ZM7.1 20.45H3.54V9H7.1v11.45Z" />
                  </svg>
                </a>
              </div>
              <p>
                Builds the app systems, UI interactions, and release flow that
                make Octi Flow clear, responsive, and dependable.
              </p>
              <p class="about-person-card__focus">
                <strong>Focus in Octi Flow:</strong> turning complicated product
                problems into interactions that feel simple in one tap.
              </p>
            </div>
          </article>

          <article class="about-person-card">
            <figure class="about-person-card__portrait">
              <img
                src="/images/about/Eugene_Personal_01.png"
                alt="Portrait of Eugene Filimonov"
                width="866"
                height="586"
                loading="lazy"
                decoding="async"
              />
            </figure>
            <div class="about-person-card__body">
              <span class="about-person-card__role">
                Co-founder · Product design &amp; creative vision
              </span>
              <div class="about-person-card__heading">
                <h3>Eugene Filimonov</h3>
                <a
                  class="about-person-card__linkedin"
                  href="https://www.linkedin.com/in/eugenefil/"
                  target="_blank"
                  rel="me noopener noreferrer"
                  aria-label="Eugene Filimonov on LinkedIn"
                >
                  <svg
                    viewBox="0 0 24 24"
                    aria-hidden="true"
                    focusable="false"
                  >
                    <path d="M20.45 20.45h-3.56v-5.57c0-1.33-.02-3.04-1.85-3.04-1.85 0-2.14 1.45-2.14 2.94v5.67H9.34V9h3.42v1.56h.05c.48-.9 1.64-1.85 3.37-1.85 3.61 0 4.27 2.37 4.27 5.46v6.28ZM5.32 7.43a2.06 2.06 0 1 1 0-4.12 2.06 2.06 0 0 1 0 4.12ZM7.1 20.45H3.54V9H7.1v11.45Z" />
                  </svg>
                </a>
              </div>
              <p>
                Shapes Octi’s character, animation, visual language, and the
                emotional experience around every interaction.
              </p>
              <p class="about-person-card__focus">
                <strong>Focus in Octi Flow:</strong> using movement and expression
                to make a digital companion feel genuinely alive.
              </p>
            </div>
          </article>
        </div>
      </div>
    </section>

    <section class="about-build" id="building-in-public">
      <div class="container">
        <div class="about-build__intro">
          <div>
            <p class="about-build__kicker">Building Octi Flow in public</p>
            <h2>The app is live. The story is still being written.</h2>
          </div>
          <p>
            We keep refining the everyday experience, expanding Octi’s world,
            and sharing the decisions, experiments, mistakes, and small wins
            behind the product.
          </p>
        </div>

        <div class="about-build-status">
          <article>
            <span class="about-build-status__number">01</span>
            <p class="about-build-status__label">Live now</p>
            <h3>Octi Flow for iOS</h3>
            <p>
              Hydration tracking, reminders, streaks, achievements, and Octi’s
              animated reactions are available on the App Store.
            </p>
          </article>

          <article class="about-build-status__active">
            <span class="about-build-status__number">02</span>
            <p class="about-build-status__label">
              <span aria-hidden="true"></span>
              Working on
            </p>
            <h3>Making each interaction feel better</h3>
            <p>
              We’re polishing everyday flows, testing clearer controls, and
              making Octi feel more responsive and rewarding.
            </p>
          </article>

          <article>
            <span class="about-build-status__number">03</span>
            <p class="about-build-status__label">Exploring next</p>
            <h3>More ways for Octi to grow with you</h3>
            <p>
              New reactions, personal touches, and thoughtful ways to support
              routines - explored without promising unfinished features.
            </p>
          </article>
        </div>

        <p class="about-build__updated">Last updated: August 2026</p>
      </div>
    </section>

    <section class="about-story-section about-moments">
      <div class="container">
        <div class="about-section-heading">
          <p class="product-kicker">From the workbench</p>
          <h2>Small moments from building the app.</h2>
          <p>
            Real decisions, experiments, and lessons from a product made by two
            people - not a polished corporate highlight reel.
          </p>
        </div>

        <div class="about-moments-grid">
          <article class="about-moment-card">
            <div
              class="about-media-placeholder about-media-placeholder--moment"
              role="img"
              aria-label="Placeholder for a video or image showing the water portion redesign"
            >
              <span class="about-placeholder-format">Video or GIF</span>
              <div class="about-placeholder-icon" aria-hidden="true">
                <span></span>
              </div>
              <small>Water portion redesign</small>
            </div>
            <div class="about-moment-card__body">
              <span>Interface experiment</span>
              <h3>Redesigning water portions</h3>
              <p>
                We tested several layouts before finding one that felt fast,
                clear, and comfortable to use with one hand.
              </p>
            </div>
          </article>

          <article class="about-moment-card">
            <div
              class="about-media-placeholder about-media-placeholder--moment"
              role="img"
              aria-label="Placeholder for a video or image showing Octi animation work"
            >
              <span class="about-placeholder-format">Video or GIF</span>
              <div class="about-placeholder-icon" aria-hidden="true">
                <span></span>
              </div>
              <small>Octi animation process</small>
            </div>
            <div class="about-moment-card__body">
              <span>Character animation</span>
              <h3>Giving Octi a little more life</h3>
              <p>
                A reaction can last only a second, but its timing, expression,
                and movement decide whether the companion feels believable.
              </p>
            </div>
          </article>

          <article class="about-moment-card">
            <div
              class="about-media-placeholder about-media-placeholder--moment"
              role="img"
              aria-label="Placeholder for an image showing Octi Flow development or testing"
            >
              <span class="about-placeholder-format">Photo or screen</span>
              <div class="about-placeholder-icon" aria-hidden="true">
                <span></span>
              </div>
              <small>Development moment</small>
            </div>
            <div class="about-moment-card__body">
              <span>Indie development</span>
              <h3>Shipping, listening, improving</h3>
              <p>
                Releasing the app was not the finish line. Feedback and daily
                use keep reshaping what we simplify, polish, and build next.
              </p>
            </div>
          </article>
        </div>
      </div>
    </section>

    <section class="about-follow">
      <div class="container">
        <div class="about-follow__card">
          <p class="about-follow__kicker">Follow the real build</p>
          <h2>Watch Octi Flow grow with us.</h2>
          <p>
            New features, animation experiments, design decisions, mistakes,
            and small wins - shared by the two people building it.
          </p>
          <div class="about-follow__actions">
            <a
              class="product-button product-button-light"
              href={instagramUrl}
              target="_blank"
              rel="noopener noreferrer"
            >
              See the latest updates
            </a>
            <a class="about-follow__text-link" href="/contact/">
              <span>Talk to the team</span>
              <svg
                class="about-follow__link-icon"
                viewBox="0 0 16 16"
                aria-hidden="true"
                focusable="false"
              >
                <path d="M3 8h10M9 4l4 4-4 4" />
              </svg>
            </a>
          </div>
          <p class="about-follow__note">
            Or choose your favorite platform in the social links below.
          </p>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>
