---
import LegalLayout from "../layouts/LegalLayout.astro";

const tocItems = [];
---

<LegalLayout
  title="Support — Octi Flow"
  description="Get help with Octi Flow, your account, purchases, subscriptions, privacy questions, and technical issues."
  canonical="/support.html"
  heroTitle="Need help?"
  heroDescription="Help with Octi Flow, your account, purchases, subscriptions, or technical issues."
  tocLabel="Support information"
  {tocItems}
>
  <section class="support-grid reveal" aria-label="Octi Flow support">
    <div class="support-card support-primary">
      <p class="support-eyebrow">Octi Flow support</p>
      <h2>Tell us what happened</h2>
      <p>
        Email us and we’ll help with the app, your account, or a technical
        issue on any supported platform.
      </p>

      <div class="support-primary-actions">
        <a
          class="support-button"
          href="mailto:support@evamariadreams.com?subject=Octi%20Flow%20Support"
        >
          Email support
        </a>
      </div>
    </div>

    <div class="support-card support-section">
      <p class="support-eyebrow">Before you email</p>
      <h2>Help us resolve it faster</h2>
      <p>Please include:</p>
      <ul>
        <li>a short description of the issue;</li>
        <li>your device model and operating system version;</li>
        <li>the Octi Flow app version;</li>
        <li>a screenshot, if it helps explain the problem.</li>
      </ul>
      <p class="support-note">
        Never send passwords, full payment card details, or other sensitive
        financial information.
      </p>
    </div>

    <div class="support-card support-section">
      <p class="support-eyebrow">Billing</p>
      <h2>Purchases and subscriptions</h2>
      <p>
        Manage a subscription or request a refund through the store where the
        purchase was made. Store policies and eligibility rules apply.
      </p>
      <div class="support-links">
        <a href="https://apps.apple.com/account/subscriptions">
          App Store subscriptions
        </a>
        <a href="https://reportaproblem.apple.com/">
          Request an App Store refund
        </a>
      </div>
    </div>

    <div class="support-card support-section support-privacy">
      <p class="support-eyebrow">Your data</p>
      <h2>Privacy questions</h2>
      <p>
        For questions or requests related to your privacy and personal data,
        contact our privacy team.
      </p>
      <a
        class="support-text-link"
        href="mailto:privacy@evamariadreams.com"
      >
        privacy@evamariadreams.com
      </a>
    </div>
  </section>
</LegalLayout>
