---
import ContentLayout from "../layouts/ContentLayout.astro";

const tocItems: { href: string; label: string }[] = [];
---

<ContentLayout
  title="Octi Flow Support - Purchases, Privacy & Technical Help"
  description="Get help with Octi Flow, purchases, subscriptions, privacy questions, and technical issues."
  canonical="https://octiflow.app/support/"
  heroTitle="Need help?"
  heroDescription="Help with Octi Flow, purchases, subscriptions, or technical issues."
  tocLabel="Support information"
  {tocItems}
>
  <section class="support-grid" aria-label="Octi Flow support">
    <div class="card card--brand support-card support-primary">
      <h2 class="card-title">Tell us what happened</h2>
      <p>
        Email us and we’ll help with the app or a technical issue on any
        supported platform.
      </p>

      <div class="support-primary-actions">
        <a
          class="button button--inverse support-button"
          href="mailto:support@evamariadreams.com?subject=Octi%20Flow%20Support"
        >
          Email support
        </a>
      </div>
    </div>

    <div class="card card--brand support-card support-section">
      <h2 class="card-title">Help us resolve it faster</h2>
      <p>Please include:</p>
      <ul>
        <li>a short description of the issue;</li>
        <li>your device model and operating system version;</li>
        <li>the Octi Flow app version;</li>
        <li>a screenshot, if it helps explain the problem.</li>
      </ul>
      <p class="support-note">
        Never send passwords, full payment card details, or other sensitive
        financial information.
      </p>
    </div>

    <div class="card card--brand support-card support-section">
      <h2 class="card-title">Purchases and subscriptions</h2>
      <p>
        Manage a subscription or request a refund through the store where the
        purchase was made. Store policies and eligibility rules apply.
      </p>
      <div class="support-links">
        <a
          class="text-link text-link--inverse"
          href="https://apps.apple.com/account/subscriptions"
        >
          App Store subscriptions
        </a>
        <a
          class="text-link text-link--inverse"
          href="https://reportaproblem.apple.com/"
        >
          Request an App Store refund
        </a>
      </div>
    </div>

    <div class="card card--brand support-card support-section support-privacy">
      <h2 class="card-title">Privacy questions</h2>
      <p>
        For questions or requests related to your privacy and personal data,
        contact our privacy team.
      </p>
      <a
        class="text-link text-link--inverse support-text-link"
        href="mailto:privacy@evamariadreams.com"
      >
        privacy@<wbr />evamariadreams.com
      </a>
    </div>
  </section>
</ContentLayout>
