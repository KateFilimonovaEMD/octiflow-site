---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import ArticleCard from "../components/blog/ArticleCard.astro";
import {
  BLOG_TOPICS,
  isPublished,
  sortPosts,
  topicSlug,
} from "../utils/blog";

const posts = sortPosts((await getCollection("blog")).filter(isPublished));
const featuredPost = posts.find((post) => post.data.featured) ?? posts[0];
const remainingPosts = posts.filter((post) => post.id !== featuredPost?.id);
const canonical = "https://octiflow.app/blog/";

const topicCounts = Object.fromEntries(
  BLOG_TOPICS.map((topic) => [
    topic,
    posts.filter((post) => post.data.category === topic).length,
  ]),
);

const structuredData = [
  {
    "@type": "Blog",
    "@id": `${canonical}#blog`,
    url: canonical,
    name: "Octi Flow Blog",
    description:
      "Evidence-based guides to hydration, exercise, sleep, everyday health and habit building from Octi Flow.",
    inLanguage: "en",
    publisher: {
      "@id": "https://octiflow.app/#organization",
    },
    blogPost: posts.map((post) => ({
      "@id": new URL(`/blog/${post.id}/#article`, Astro.site).href,
    })),
  },
  {
    "@type": "ItemList",
    "@id": `${canonical}#articles`,
    name: "Octi Flow hydration, health and habit guides",
    numberOfItems: posts.length,
    itemListElement: posts.map((post, index) => ({
      "@type": "ListItem",
      position: index + 1,
      name: post.data.title,
      url: new URL(`/blog/${post.id}/`, Astro.site).href,
    })),
  },
];
---

<BaseLayout
  title="Hydration, Health & Habit Guides | Octi Flow"
  description="Evidence-based guides to hydration, exercise, sleep, everyday health and habit building, with careful sourcing and practical context."
  {canonical}
  imageAlt="Octi, the animated companion from the Octi Flow hydration tracker app"
  {structuredData}
>
  <main class="blog-page-surface">
    <header class="blog-hero">
      <div class="container">
        <p class="eyebrow section-eyebrow">Evidence-based guides</p>
        <h1 class="blog-gradient-title">Hydration, health and habits, explained clearly.</h1>
        <p>
          Practical guides built from medical guidance and peer-reviewed research,
          with the limits of the evidence stated plainly.
        </p>
      </div>
    </header>

    <div class="container blog-content">
      {
        featuredPost ? (
          <>
            <section
              aria-labelledby="start-here-title"
              data-featured-section
              data-topic={topicSlug(featuredPost.data.category)}
            >
              <div class="section-heading section-heading--blog">
                <p class="eyebrow section-eyebrow">Start here</p>
                <h2 id="start-here-title" class="visually-hidden">Start here</h2>
              </div>
              <ArticleCard post={featuredPost} featured />
            </section>

            <section class="blog-browser" aria-labelledby="browse-title">
              <div class="section-heading blog-browser__heading">
                <div>
                  <p class="eyebrow section-eyebrow">Browse the library</p>
                  <h2 id="browse-title">Explore by topic</h2>
                </div>
                <p class="blog-filter-status" data-filter-status aria-live="polite">
                  {posts.length} articles
                </p>
              </div>

              <div
                class="blog-topic-filters"
                data-blog-filters
                aria-label="Filter articles by topic"
                hidden
              >
                <button
                  class="blog-topic-filter is-active"
                  type="button"
                  data-topic-filter="all"
                  aria-pressed="true"
                >
                  <span>All</span>
                  <span class="blog-topic-filter__count">{posts.length}</span>
                </button>
                {BLOG_TOPICS.map((topic) => (
                  <button
                    id={topicSlug(topic)}
                    class="blog-topic-filter"
                    type="button"
                    data-topic-filter={topicSlug(topic)}
                    aria-pressed="false"
                  >
                    <span>{topic}</span>
                    <span class="blog-topic-filter__count">{topicCounts[topic]}</span>
                  </button>
                ))}
              </div>

              <div class="article-grid" id="blog-article-grid" data-article-grid>
                {remainingPosts.map((post) => (
                  <div
                    class="article-grid__item"
                    data-article-item
                    data-topic={topicSlug(post.data.category)}
                  >
                    <ArticleCard {post} />
                  </div>
                ))}
              </div>

              <p class="blog-no-results" data-no-results hidden>
                No articles are available in this topic yet.
              </p>
            </section>

            <script is:inline>
              (() => {
                const filters = document.querySelector("[data-blog-filters]");
                const buttons = Array.from(
                  document.querySelectorAll("[data-topic-filter]"),
                );
                const items = Array.from(
                  document.querySelectorAll("[data-article-item]"),
                );
                const featured = document.querySelector("[data-featured-section]");
                const status = document.querySelector("[data-filter-status]");
                const empty = document.querySelector("[data-no-results]");

                if (!filters || buttons.length === 0) return;
                filters.hidden = false;

                const validTopics = new Set(
                  buttons.map((button) => button.dataset.topicFilter),
                );

                const applyFilter = (requestedTopic, updateUrl = false) => {
                  const topic = validTopics.has(requestedTopic)
                    ? requestedTopic
                    : "all";

                  let visibleCount = 0;

                  if (featured) {
                    const showFeatured =
                      topic === "all" || featured.dataset.topic === topic;
                    featured.hidden = !showFeatured;
                    if (showFeatured) visibleCount += 1;
                  }

                  items.forEach((item) => {
                    const show = topic === "all" || item.dataset.topic === topic;
                    item.hidden = !show;
                    if (show) visibleCount += 1;
                  });

                  buttons.forEach((button) => {
                    const active = button.dataset.topicFilter === topic;
                    button.classList.toggle("is-active", active);
                    button.setAttribute("aria-pressed", String(active));
                  });

                  if (status) {
                    status.textContent = `${visibleCount} ${visibleCount === 1 ? "article" : "articles"}`;
                  }
                  if (empty) empty.hidden = visibleCount !== 0;

                  if (updateUrl) {
                    const url = new URL(window.location.href);
                    url.hash = topic === "all" ? "" : topic;
                    history.replaceState(null, "", `${url.pathname}${url.search}${url.hash}`);
                  }
                };

                const topicFromHash = () =>
                  window.location.hash ? window.location.hash.slice(1) : "all";

                buttons.forEach((button) => {
                  button.addEventListener("click", () => {
                    applyFilter(button.dataset.topicFilter || "all", true);
                  });
                });

                window.addEventListener("hashchange", () => {
                  applyFilter(topicFromHash());
                });

                applyFilter(topicFromHash());
              })();
            </script>
          </>
        ) : (
          <section class="blog-empty">
            <p class="eyebrow section-eyebrow">Coming soon</p>
            <h2>Thoughtful hydration guides are on the way</h2>
            <p>
              We are preparing practical articles about hydration, health and
              everyday habits.
            </p>
            <a class="button button--inverse button-link" href="/">Explore Octi Flow</a>
          </section>
        )
      }
    </div>
  </main>
</BaseLayout>
