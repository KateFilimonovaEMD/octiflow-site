---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import ArticleCard from "../components/blog/ArticleCard.astro";
import {
  BLOG_TOPICS,
  isPublished,
  postUrl,
  readingTime,
  sortPosts,
  topicSlug,
} from "../utils/blog";

const posts = sortPosts((await getCollection("blog")).filter(isPublished));
const featuredPost = posts.find((post) => post.data.featured) ?? posts[0];
const canonical = "https://octiflow.app/blog/";

const topicDescriptions: Record<(typeof BLOG_TOPICS)[number], string> = {
  "Hydration Basics": "Daily intake, what counts as fluid, and the fundamentals worth getting right.",
  "Habits & Tracking": "Simple ways to build a drinking routine that fits an ordinary day.",
  "Health & Safety": "Dehydration signs, headaches, illness, and situations where context matters.",
  "Exercise & Environment": "Hydration for workouts, heat, sweat loss, and electrolytes.",
  "Sleep & Wellness": "What research can and cannot tell us about hydration, sleep, and skin.",
};

const structuredData = [
  {
    "@type": "Blog",
    "@id": `${canonical}#blog`,
    url: canonical,
    name: "Octi Flow Blog",
    description:
      "Evidence-based guides to hydration, exercise, sleep, everyday health and habit building from Octi Flow.",
    inLanguage: "en",
    publisher: {
      "@id": "https://octiflow.app/#organization",
    },
    blogPost: posts.map((post) => ({
      "@id": new URL(`/blog/${post.id}/#article`, Astro.site).href,
    })),
  },
  {
    "@type": "ItemList",
    "@id": `${canonical}#articles`,
    name: "Octi Flow hydration, health and habit guides",
    numberOfItems: posts.length,
    itemListElement: posts.map((post, index) => ({
      "@type": "ListItem",
      position: index + 1,
      name: post.data.title,
      url: new URL(`/blog/${post.id}/`, Astro.site).href,
    })),
  },
];
---

<BaseLayout
  title="Hydration, Health & Habit Guides | Octi Flow"
  description="Carefully sourced guides to hydration, exercise, sleep, everyday health and habit building, with evidence limits stated clearly."
  {canonical}
  imageAlt="Octi, the animated companion from the Octi Flow hydration tracker app"
  {structuredData}
>
  <main class="blog-page-surface blog-index">
    <header class="blog-editorial-hero">
      <div class="container blog-editorial-hero__layout">
        <div class="blog-editorial-hero__copy">
          <p class="eyebrow section-eyebrow">Evidence-based guides</p>
          <h1>Hydration guidance you can actually use.</h1>
          <p class="blog-editorial-hero__deck">
            Practical guides on daily intake, dehydration, exercise, sleep and habits.
            Sources are linked in every article, with important limits stated clearly.
          </p>
          <div class="blog-editorial-hero__trust" aria-label="About the Octi Flow blog">
            <span>{posts.length} guides</span>
            <span>{BLOG_TOPICS.length} topics</span>
            <a href="/editorial-standards/">Editorial standards</a>
          </div>
        </div>

        {
          featuredPost && (
            <a class="blog-feature" href={postUrl(featuredPost)} aria-label={`Start here: ${featuredPost.data.title}`}>
              <div class="blog-feature__media">
                {featuredPost.data.image ? (
                  <picture>
                    {featuredPost.data.imageAvif && <source srcset={featuredPost.data.imageAvif} type="image/avif" />}
                    {featuredPost.data.imageWebp && <source srcset={featuredPost.data.imageWebp} type="image/webp" />}
                    <img
                      src={featuredPost.data.image}
                      alt={featuredPost.data.imageAlt ?? ""}
                      width={featuredPost.data.imageWidth}
                      height={featuredPost.data.imageHeight}
                      loading="eager"
                      fetchpriority="high"
                    />
                  </picture>
                ) : (
                  <span class="article-cover-placeholder" aria-hidden="true">
                    <span>Cover image coming soon</span>
                  </span>
                )}
              </div>
              <div class="blog-feature__content">
                <p class="blog-feature__eyebrow">Start here</p>
                <h2>{featuredPost.data.title}</h2>
                <p>{featuredPost.data.description}</p>
                <div class="blog-feature__footer">
                  <span>{readingTime(featuredPost.body)} min read</span>
                  <span class="blog-feature__arrow" aria-hidden="true">→</span>
                </div>
              </div>
            </a>
          )
        }
      </div>
    </header>

    <div class="blog-topic-nav-shell">
      <div class="container">
        <nav class="blog-topic-nav" aria-label="Jump to a blog topic">
          <span class="blog-topic-nav__label">Explore</span>
          <div class="blog-topic-nav__links">
            {BLOG_TOPICS.map((topic) => <a href={`#${topicSlug(topic)}`}>{topic}</a>)}
          </div>
        </nav>
      </div>
    </div>

    <div class="container blog-editorial-library">
      {BLOG_TOPICS.map((topic, topicIndex) => {
        const topicPosts = posts.filter((post) => post.data.category === topic);
        const slug = topicSlug(topic);

        return (
          <section
            id={slug}
            class:list={["blog-resource-section", topicIndex % 2 === 1 && "blog-resource-section--tinted"]}
            aria-labelledby={`${slug}-title`}
          >
            <header class="blog-resource-section__intro">
              <p class="blog-resource-section__count">
                {topicPosts.length} {topicPosts.length === 1 ? "guide" : "guides"}
              </p>
              <h2 id={`${slug}-title`}>{topic}</h2>
              <p>{topicDescriptions[topic]}</p>
            </header>

            <div class="blog-resource-list">
              {topicPosts.map((post) => <ArticleCard {post} variant="row" showTopic={false} />)}
            </div>
          </section>
        );
      })}
    </div>
  </main>
</BaseLayout>
