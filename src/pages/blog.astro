---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import ArticleCard from "../components/blog/ArticleCard.astro";
import { isPublished, sortPosts } from "../utils/blog";

const posts = sortPosts((await getCollection("blog")).filter(isPublished));
const featuredPost = posts.find((post) => post.data.featured) ?? posts[0];
const remainingPosts = posts.filter((post) => post.id !== featuredPost?.id);
const canonical = "https://octiflow.app/blog/";

const structuredData = [
  {
    "@type": "Blog",
    "@id": `${canonical}#blog`,
    url: canonical,
    name: "Octi Flow Blog",
    description:
      "Practical, evidence-aware guides to hydration habits, water tracking, reminders, and getting more from Octi Flow.",
    publisher: {
      "@id": "https://octiflow.app/#organization",
    },
    about: {
      "@id": "https://octiflow.app/#app",
    },
    blogPost: posts.map((post) => ({
      "@id": new URL(`/blog/${post.id}/#article`, Astro.site).href,
    })),
  },
  {
    "@type": "ItemList",
    "@id": `${canonical}#articles`,
    name: "Octi Flow hydration articles",
    numberOfItems: posts.length,
    itemListElement: posts.map((post, index) => ({
      "@type": "ListItem",
      position: index + 1,
      name: post.data.title,
      url: new URL(`/blog/${post.id}/`, Astro.site).href,
    })),
  },
];
---

<BaseLayout
  title="Hydration Tips, Habits & Tracking Guides - Octi Flow"
  description="Practical, evidence-aware guides to hydration habits, water tracking, reminders, and getting more from Octi Flow."
  {canonical}
  imageAlt="Octi, the animated companion from the Octi Flow hydration tracker app"
  {structuredData}
>
  <main class="blog-page-surface">
    <header class="blog-hero">
      <div class="container">
        <h1 class="blog-gradient-title">Small habits. Better hydration.</h1>
        <p>
          Practical guides for building a sustainable water routine, using
          reminders well, and making hydration tracking less demanding.
        </p>
      </div>
    </header>

    <div class="container blog-content">
      {
        featuredPost ? (
          <>
            <section aria-label="Featured article">
              <div class="section-heading section-heading--blog">
                <p class="eyebrow section-eyebrow">Octi Flow Blog</p>
              </div>
              <ArticleCard post={featuredPost} featured />
            </section>

            {remainingPosts.length > 0 && (
              <section aria-labelledby="latest-title">
                <div class="section-heading">
                  <p class="eyebrow section-eyebrow">Explore the blog</p>
                  <h2 id="latest-title">Latest articles</h2>
                </div>

                <div
                  class="article-grid"
                  id="blog-article-grid"
                  data-article-grid
                >
                  {remainingPosts.map((post) => (
                    <div class="article-grid__item" data-article-item>
                      <ArticleCard {post} />
                    </div>
                  ))}
                </div>

                {remainingPosts.length > 4 && (
                  <div class="blog-load-more">
                    <button
                      class="blog-load-more__button"
                      type="button"
                      aria-controls="blog-article-grid"
                      data-load-more
                      hidden
                    >
                      <span>Load more articles</span>
                      <svg
                        class="icon-stroke-centered"
                        viewBox="0 0 16 16"
                        aria-hidden="true"
                      >
                        <path d="M4 6l4 4 4-4" />
                      </svg>
                    </button>
                  </div>
                )}
              </section>
            )}

            <script is:inline>
              (() => {
                const grid = document.querySelector("[data-article-grid]");
                const button = document.querySelector("[data-load-more]");

                if (!grid || !button) return;

                const items = Array.from(
                  grid.querySelectorAll("[data-article-item]"),
                );
                const initialCount = 4;
                const step = 2;
                let visibleCount = Math.min(initialCount, items.length);

                const update = (animateNewItems = false) => {
                  items.forEach((item, index) => {
                    const shouldShow = index < visibleCount;
                    const wasHidden = item.hidden;

                    item.hidden = !shouldShow;

                    if (animateNewItems && shouldShow && wasHidden) {
                      item.classList.remove("is-revealed");
                      requestAnimationFrame(() => {
                        item.classList.add("is-revealed");
                      });
                    }
                  });

                  const remaining = items.length - visibleCount;
                  button.hidden = remaining <= 0;

                  if (remaining > 0) {
                    button.setAttribute(
                      "aria-label",
                      `Load ${Math.min(step, remaining)} more articles`,
                    );
                  }
                };

                update();

                button.addEventListener("click", () => {
                  visibleCount = Math.min(
                    visibleCount + step,
                    items.length,
                  );
                  update(true);
                });
              })();
            </script>
          </>
        ) : (
          <section class="blog-empty">
            <p class="eyebrow section-eyebrow">Coming soon</p>
            <h2>Thoughtful hydration guides are on the way</h2>
            <p>
              We are preparing practical articles about daily water habits,
              reminders, and hydration tracking.
            </p>
            <a class="button button--inverse button-link" href="/">Explore Octi Flow</a>
          </section>
        )
      }
    </div>
  </main>
</BaseLayout>
