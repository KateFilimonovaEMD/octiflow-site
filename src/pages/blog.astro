---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import ArticleCard from "../components/blog/ArticleCard.astro";
import {
  BLOG_TOPICS,
  isPublished,
  postUrl,
  readingTime,
  sortPosts,
  topicSlug,
} from "../utils/blog";

const posts = sortPosts((await getCollection("blog")).filter(isPublished));
const featuredPost = posts.find((post) => post.data.featured) ?? posts[0];
const featuredLabel = featuredPost?.data.featured ? "Featured guide" : "Latest guide";
const canonical = "https://octiflow.app/blog/";

const topicDescriptions: Record<(typeof BLOG_TOPICS)[number], string> = {
  "Hydration Basics": "Daily intake, what counts as fluid, and the fundamentals worth getting right.",
  "Habits & Tracking": "Simple ways to build a drinking routine that fits an ordinary day.",
  "Health & Safety": "Dehydration signs, headaches, illness, and situations where context matters.",
  "Exercise & Environment": "Hydration for workouts, heat, sweat loss, and electrolytes.",
  "Sleep & Wellness": "What research can and cannot tell us about hydration, sleep, and skin.",
};

const structuredData = [
  {
    "@type": "Blog",
    "@id": `${canonical}#blog`,
    url: canonical,
    name: "Octi Flow Blog",
    description:
      "Evidence-based guides to hydration, exercise, sleep, everyday health and habit building from Octi Flow.",
    inLanguage: "en",
    publisher: {
      "@id": "https://octiflow.app/#organization",
    },
    blogPost: posts.map((post) => ({
      "@id": new URL(`/blog/${post.id}/#article`, Astro.site).href,
    })),
  },
  {
    "@type": "ItemList",
    "@id": `${canonical}#articles`,
    name: "Octi Flow hydration, health and habit guides",
    numberOfItems: posts.length,
    itemListElement: posts.map((post, index) => ({
      "@type": "ListItem",
      position: index + 1,
      name: post.data.title,
      url: new URL(`/blog/${post.id}/`, Astro.site).href,
    })),
  },
];
---

<BaseLayout
  title="Hydration, Health & Habit Guides | Octi Flow"
  description="Carefully sourced guides to hydration, exercise, sleep, everyday health and habit building, with evidence limits stated clearly."
  {canonical}
  imageAlt="Octi, the animated companion from the Octi Flow hydration tracker app"
  {structuredData}
>
  <main class="blog-page-surface blog-index">
    <header class="blog-editorial-hero">
      <div class="container blog-editorial-hero__layout">
        <div class="blog-editorial-hero__copy">
          <p class="eyebrow section-eyebrow">Evidence-based guides</p>
          <h1>Hydration guidance you can actually use.</h1>
          <p class="blog-editorial-hero__deck">
            Practical guides on daily intake, dehydration, exercise, sleep and habits.
            Sources are linked in every article, with important limits stated clearly.
          </p>
        </div>

        {
          featuredPost && (
            <a class="blog-feature" href={postUrl(featuredPost)} aria-label={`${featuredLabel}: ${featuredPost.data.title}`}>
              <div class="blog-feature__media">
                {featuredPost.data.image ? (
                  <>
                    <picture>
                      {featuredPost.data.imageAvif && <source srcset={featuredPost.data.imageAvif} type="image/avif" />}
                      {featuredPost.data.imageWebp && <source srcset={featuredPost.data.imageWebp} type="image/webp" />}
                      <img
                        src={featuredPost.data.image}
                        alt={featuredPost.data.imageAlt ?? ""}
                        width={featuredPost.data.imageWidth}
                        height={featuredPost.data.imageHeight}
                        loading="eager"
                        fetchpriority="high"
                      />
                    </picture>
                    <div class="blog-feature__media-overlay">
                      <h2>{featuredPost.data.title}</h2>
                    </div>
                  </>
                ) : (
                  <span class="article-cover-placeholder" aria-hidden="true">
                    <span>Cover image coming soon</span>
                  </span>
                )}
              </div>
              <div class="blog-feature__content">
                <p class="blog-feature__eyebrow">{featuredLabel}</p>
                {!featuredPost.data.image && <h2>{featuredPost.data.title}</h2>}
                <p>{featuredPost.data.description}</p>
                <div class="blog-feature__footer">
                  <span>{readingTime(featuredPost.body)} min read</span>
                  <span class="blog-feature__arrow" aria-hidden="true"></span>
                </div>
              </div>
            </a>
          )
        }
      </div>
    </header>

    <div class="blog-topic-nav-shell" data-blog-controls hidden>
      <div class="container">
        <nav class="blog-topic-nav" aria-label="Filter blog guides by topic">
          <span class="blog-topic-nav__label">Explore</span>
          <div class="blog-topic-nav__links" role="group" aria-label="Blog topics">
            <button
              class="blog-topic-filter is-active"
              type="button"
              data-topic-filter="all"
              aria-pressed="true"
            >
              <span>All guides</span>
              <span class="blog-topic-filter__count">{posts.length}</span>
            </button>
            {
              BLOG_TOPICS.map((topic) => {
                const count = posts.filter((post) => post.data.category === topic).length;
                return (
                  <button
                    class="blog-topic-filter"
                    type="button"
                    data-topic-filter={topicSlug(topic)}
                    data-topic-label={topic}
                    data-topic-description={topicDescriptions[topic]}
                    aria-pressed="false"
                  >
                    <span>{topic}</span>
                    <span class="blog-topic-filter__count">{count}</span>
                  </button>
                );
              })
            }
          </div>
        </nav>
      </div>
    </div>

    <section id="guides" class="container blog-filter-library" aria-labelledby="blog-library-title">
      <header class="blog-filter-library__header">
        <div>
          <p class="eyebrow section-eyebrow">Browse the library</p>
          <h2 id="blog-library-title" data-library-title>All guides</h2>
          <p data-library-description>
            Explore every Octi Flow guide, ordered from newest to oldest.
          </p>
        </div>
        <p class="blog-filter-library__status" data-library-status aria-live="polite">
          {posts.length} guides
        </p>
      </header>

      <div class="blog-filter-grid" data-blog-grid>
        {posts.map((post) => <ArticleCard {post} variant="row" showTopic={true} />)}
      </div>

      <div class="blog-load-more-shell" data-load-more-shell hidden>
        <button class="blog-load-more" type="button" data-load-more aria-label="Show more guides">
          <span class="blog-load-more__label" data-load-more-label>Show more guides</span>
          <span class="blog-load-more__arrow" aria-hidden="true"></span>
        </button>
      </div>
    </section>

    <script is:inline>
      (() => {
        const controls = document.querySelector("[data-blog-controls]");
        const grid = document.querySelector("[data-blog-grid]");
        if (!controls || !grid) return;

        const cards = Array.from(grid.querySelectorAll(".article-card[data-topic]"));
        const filters = Array.from(controls.querySelectorAll("[data-topic-filter]"));
        const loadMoreShell = document.querySelector("[data-load-more-shell]");
        const loadMore = document.querySelector("[data-load-more]");
        const loadMoreLabel = document.querySelector("[data-load-more-label]");
        const title = document.querySelector("[data-library-title]");
        const description = document.querySelector("[data-library-description]");
        const status = document.querySelector("[data-library-status]");

        const initialVisible = 4;
        const step = 4;
        const defaultDescription = "Explore every Octi Flow guide, ordered from newest to oldest.";
        let activeTopic = "all";
        let visibleLimit = initialVisible;

        controls.hidden = false;

        const validTopics = new Set(filters.map((button) => button.dataset.topicFilter));

        const updateUrl = (topic, replace = false) => {
          const url = new URL(window.location.href);
          if (topic === "all") {
            url.searchParams.delete("topic");
          } else {
            url.searchParams.set("topic", topic);
          }
          url.hash = "";
          const method = replace ? "replaceState" : "pushState";
          window.history[method]({}, "", url);
        };

        const render = ({ updateHistory = false, replaceHistory = false } = {}) => {
          const matching = cards.filter((card) => activeTopic === "all" || card.dataset.topic === activeTopic);
          let shown = 0;

          cards.forEach((card) => {
            const matches = activeTopic === "all" || card.dataset.topic === activeTopic;
            const shouldShow = matches && shown < visibleLimit;

            if (shouldShow) shown += 1;
            card.hidden = !shouldShow;
          });

          filters.forEach((button) => {
            const selected = button.dataset.topicFilter === activeTopic;
            button.classList.toggle("is-active", selected);
            button.setAttribute("aria-pressed", String(selected));
          });

          const activeButton = filters.find((button) => button.dataset.topicFilter === activeTopic);
          const topicLabel = activeButton?.dataset.topicLabel ?? "All guides";
          const topicDescription = activeButton?.dataset.topicDescription ?? defaultDescription;

          if (title) title.textContent = topicLabel;
          if (description) description.textContent = topicDescription;
          if (status) {
            status.textContent = shown < matching.length
              ? `Showing ${shown} of ${matching.length} guides`
              : `${matching.length} ${matching.length === 1 ? "guide" : "guides"}`;
          }

          const remaining = Math.max(0, matching.length - shown);
          if (loadMoreShell) loadMoreShell.hidden = remaining === 0;
          if (loadMoreLabel && remaining > 0) {
            loadMoreLabel.textContent = `Show ${Math.min(step, remaining)} more ${remaining === 1 ? "guide" : "guides"}`;
          }

          if (updateHistory) updateUrl(activeTopic, replaceHistory);
        };

        const selectTopic = (topic, { updateHistory = true } = {}) => {
          const scrollY = window.scrollY;
          activeTopic = validTopics.has(topic) ? topic : "all";
          visibleLimit = initialVisible;
          render({ updateHistory });

          requestAnimationFrame(() => {
            window.scrollTo({ top: scrollY, left: 0, behavior: "auto" });
          });
        };

        filters.forEach((button) => {
          button.addEventListener("click", () => {
            selectTopic(button.dataset.topicFilter ?? "all", { updateHistory: true });
          });
        });

        loadMore?.addEventListener("click", () => {
          visibleLimit += step;
          render();
        });

        window.addEventListener("popstate", () => {
          const topic = new URL(window.location.href).searchParams.get("topic") ?? "all";
          selectTopic(topic, { updateHistory: false });
        });

        const requestedTopic = new URL(window.location.href).searchParams.get("topic") ?? "all";
        activeTopic = validTopics.has(requestedTopic) ? requestedTopic : "all";
        render({ updateHistory: requestedTopic !== activeTopic, replaceHistory: true });
      })();
    </script>
  </main>
</BaseLayout>
