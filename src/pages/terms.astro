---
import BaseLayout from '../layouts/BaseLayout.astro';

const sections = [
  { id: 'acceptance-of-terms', label: 'Acceptance of terms' },
  { id: 'use-of-the-app', label: 'Use of the app' },
  { id: 'health-and-wellness-disclaimer', label: 'Health and wellness disclaimer' },
  { id: 'public-information-basis', label: 'Public-information basis' },
  { id: 'accounts', label: 'Accounts' },
  { id: 'premium-features-and-purchases', label: 'Premium features and purchases' },
  { id: 'permitted-and-prohibited-conduct', label: 'Permitted and prohibited conduct' },
  { id: 'availability-and-changes', label: 'Availability and changes' },
  { id: 'disclaimer-of-warranties', label: 'Disclaimer of warranties' },
  { id: 'limitation-of-liability', label: 'Limitation of liability' },
  { id: 'termination', label: 'Termination' },
  { id: 'changes-to-these-terms', label: 'Changes to these terms' },
  { id: 'contact', label: 'Contact' },
];
---

<BaseLayout
  title="Terms of Use — Octi Flow"
  description="Terms of Use for the Octi Flow hydration companion app."
>
  <header class="hero">
    <div class="container reveal">
      <h1>Terms for using the app</h1>
      <p>
        These Terms of Use govern access to and use of the Octi Flow app and
        the EvaMariaDreams website.
      </p>
    </div>
  </header>

  <div class="container layout">
    <aside class="toc" aria-label="Terms of Use sections">
      <details class="toc-disclosure">
        <summary>Jump to a section</summary>

        <div class="toc-menu">
          {
            sections.map((section) => (
              <a href={`#${section.id}`}>{section.label}</a>
            ))
          }
        </div>
      </details>
    </aside>

    <article class="policy">
      <section class="reveal" id="acceptance-of-terms">
        <h2>Acceptance of terms</h2>
        <p>
          By accessing or using the Octi Flow app or the EvaMariaDreams website,
          you agree to these Terms of Use. If you do not agree, you should not
          use the app or website.
        </p>
      </section>

      <section class="reveal" id="use-of-the-app">
        <h2>Use of the app</h2>
        <p>
          Octi Flow is intended for general wellness, habit support, and
          informational purposes only. The app is not a medical service and does
          not provide medical advice, diagnosis, or treatment.
        </p>
      </section>

      <section class="reveal" id="health-and-wellness-disclaimer">
        <h2>Health and wellness disclaimer</h2>
        <p>
          Any hydration goals, estimates, reminders, formulas, or
          recommendations provided by the app are informational only. They are
          not a substitute for professional medical advice or individual
          clinical guidance.
        </p>
        <p>
          If you have any medical condition, health concern, or question related
          to hydration, nutrition, or physical well-being, you should consult a
          qualified healthcare professional.
        </p>
      </section>

      <section class="reveal" id="public-information-basis">
        <h2>Public-information basis</h2>
        <p>
          Certain formulas, reference values, or informational calculations used
          in the app may be derived from publicly available sources.
          EvaMariaDreams does not guarantee that any estimate or recommendation
          is appropriate for every individual user or situation.
        </p>
      </section>

      <section class="reveal" id="accounts">
        <h2>Accounts</h2>
        <p>Octi Flow does not create user accounts at this time.</p>
      </section>

      <section class="reveal" id="premium-features-and-purchases">
        <h2>Premium features and purchases</h2>
        <p>
          Octi Flow may offer premium features through in-app purchases. Premium
          features may include expanded app functionality and visual
          customization, including themes, backgrounds, and companion
          variations.
        </p>
        <p>
          All purchases are processed by the applicable platform provider.
          Billing, refunds, cancellations, and subscription management may be
          subject to the policies and terms of that platform.
        </p>
      </section>

      <section class="reveal" id="permitted-and-prohibited-conduct">
        <h2>Permitted and prohibited conduct</h2>
        <ul>
          <li>
            You may use the app only for lawful, personal, and non-commercial
            purposes unless otherwise permitted.
          </li>
          <li>
            You may not interfere with, misuse, reverse engineer, copy, scrape,
            or exploit the app except as allowed by applicable law.
          </li>
          <li>
            You may not use the app in a way that disrupts or harms the app,
            website, or other users.
          </li>
        </ul>
      </section>

      <section class="reveal" id="availability-and-changes">
        <h2>Availability and changes</h2>
        <p>
          We may update, modify, suspend, or discontinue any part of the app or
          website, including premium features, visual content, or app
          functionality, at any time.
        </p>
      </section>

      <section class="reveal" id="disclaimer-of-warranties">
        <h2>Disclaimer of warranties</h2>
        <p>
          The app and website are provided on an “as is” and “as available”
          basis to the fullest extent permitted by law. EvaMariaDreams makes no
          warranties regarding availability, accuracy, reliability, or fitness
          for a particular purpose.
        </p>
      </section>

      <section class="reveal" id="limitation-of-liability">
        <h2>Limitation of liability</h2>
        <p>
          To the fullest extent permitted by law, EvaMariaDreams will not be
          liable for indirect, incidental, special, consequential, or punitive
          damages, or for decisions made based on the use of the app, its
          reminders, estimates, or informational content.
        </p>
      </section>

      <section class="reveal" id="termination">
        <h2>Termination</h2>
        <p>
          We may suspend or terminate access to the app or website if these Terms
          are violated or if necessary to protect the app, website, users, or
          legal interests.
        </p>
      </section>

      <section class="reveal" id="changes-to-these-terms">
        <h2>Changes to these terms</h2>
        <p>
          These Terms of Use may be updated from time to time. Continued use of
          the app or website after changes become effective constitutes
          acceptance of the revised Terms.
        </p>
      </section>

      <section class="reveal" id="contact">
        <h2>Contact</h2>

        <div class="contact-card">
          <p>
            Questions about these Terms of Use may be sent to
            <a href="mailto:legal@evamariadreams.com">
              legal@evamariadreams.com
            </a>.
          </p>
        </div>
      </section>

      <span class="document-status">Last updated: May 24, 2026</span>
    </article>
  </div>
</BaseLayout>
