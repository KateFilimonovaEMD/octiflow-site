---
import SiteFooter from "../components/SiteFooter.astro";
import SiteHeader from "../components/SiteHeader.astro";
import "../styles/site.css";

interface TocItem {
  href: string;
  label: string;
}

interface Props {
  title: string;
  description: string;
  canonical: string;
  heroTitle: string;
  heroDescription: string;
  tocLabel: string;
  tocItems: TocItem[];
}

const {
  title,
  description,
  canonical,
  heroTitle,
  heroDescription,
  tocLabel,
  tocItems,
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#073080" />
    <meta name="robots" content="index,follow" />
    <link rel="canonical" href={canonical} />

    <title>{title}</title>
    <meta name="description" content={description} />

    <link
      rel="icon"
      href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'%3E%3Ccircle cx='50' cy='50' r='45' fill='%23015cc6'/%3E%3C/svg%3E"
    />
  </head>

  <body>
    <SiteHeader />

    <main>
      <header class="hero">
        <div class="container reveal">
          <h1>{heroTitle}</h1>
          <p>{heroDescription}</p>
        </div>
      </header>

      <div class="container layout">
        <aside class="toc" aria-label={tocLabel}>
          <details class="toc-disclosure">
            <summary>Jump to a section</summary>

            <div class="toc-menu">
              {
                tocItems.map((item) => (
                  <a href={item.href}>{item.label}</a>
                ))
              }
            </div>
          </details>
        </aside>

        <article class="policy">
          <slot />
        </article>
      </div>
    </main>

    <SiteFooter />
    <script src="../scripts/site.js"></script>
  </body>
</html>
