---
import type { BlogPost } from "../utils/blog";
import BaseLayout from "./BaseLayout.astro";
import ArticleCta from "../components/blog/ArticleCta.astro";
import RelatedArticles from "../components/blog/RelatedArticles.astro";
import { formatDate, postUrl, readingTime } from "../utils/blog";

interface Props {
  post: BlogPost;
  relatedPosts: BlogPost[];
  headings: { depth: number; slug: string; text: string }[];
}

const { post, relatedPosts, headings } = Astro.props;
const { data } = post;
const canonical = new URL(postUrl(post), Astro.site).href;
const modifiedDate = data.updatedDate ?? data.publishDate;
const tocHeadings = headings.filter((heading) => heading.depth === 2 || heading.depth === 3);
const organizationId = "https://octiflow.app/#organization";
const applicationId = "https://octiflow.app/#app";
const articleImage = data.socialImage ?? data.image;

const structuredData = [
  {
    "@type": "BlogPosting",
    "@id": `${canonical}#article`,
    headline: data.title,
    description: data.description,
    datePublished: data.publishDate.toISOString(),
    dateModified: modifiedDate.toISOString(),
    mainEntityOfPage: {
      "@type": "WebPage",
      "@id": canonical,
    },
    isPartOf: {
      "@id": "https://octiflow.app/blog/#blog",
    },
    author: {
      "@id": organizationId,
    },
    publisher: {
      "@id": organizationId,
    },
    about: {
      "@id": applicationId,
    },
    ...(articleImage && {
      image: {
        "@type": "ImageObject",
        url: new URL(articleImage, Astro.site).href,
        width: data.socialImage ? 1200 : data.imageWidth,
        height: data.socialImage ? 630 : data.imageHeight,
        caption: data.imageAlt,
      },
    }),
  },
  {
    "@type": "BreadcrumbList",
    "@id": `${canonical}#breadcrumb`,
    itemListElement: [
      {
        "@type": "ListItem",
        position: 1,
        name: "Octi Flow",
        item: "https://octiflow.app/",
      },
      {
        "@type": "ListItem",
        position: 2,
        name: "Blog",
        item: "https://octiflow.app/blog/",
      },
      {
        "@type": "ListItem",
        position: 3,
        name: data.title,
        item: canonical,
      },
    ],
  },
];
---

<BaseLayout
  title={data.seoTitle ?? `${data.title} - Octi Flow`}
  description={data.description}
  {canonical}
  image={data.socialImage ?? data.image}
  imageAlt={data.imageAlt}
  imageWidth={data.socialImage ? 1200 : data.imageWidth}
  imageHeight={data.socialImage ? 630 : data.imageHeight}
  type="article"
  publishedTime={data.publishDate}
  modifiedTime={modifiedDate}
  {structuredData}
>
  <main class="article-page">
    <header class="article-hero">
      <div class="container article-hero__inner heading-group">
        <nav class="breadcrumbs meta-copy" aria-label="Breadcrumb">
          <a href="/">Octi Flow</a>
          <span aria-hidden="true">/</span>
          <a href="/blog/">Blog</a>
        </nav>
        <p class="eyebrow">{data.category}</p>
        <h1 class="article-title">{data.title}</h1>
        <p class="article-deck article-lead">{data.description}</p>
        <div class="article-byline meta-copy meta-copy--strong">
          <span>By <a href="/about/" rel="author">{data.author}</a></span>
          <span aria-hidden="true">·</span>
          <time datetime={data.publishDate.toISOString()}>
            {formatDate(data.publishDate)}
          </time>
          {
            data.updatedDate && (
              <>
                <span aria-hidden="true">·</span>
                <span>Updated {formatDate(data.updatedDate)}</span>
              </>
            )
          }
          <span aria-hidden="true">·</span>
          <span>{readingTime(post.body)} min read</span>
        </div>
      </div>
    </header>

    {
      data.image && (
        <figure class="container article-cover">
          <picture>
            {data.imageAvif && <source srcset={data.imageAvif} type="image/avif" />}
            {data.imageWebp && <source srcset={data.imageWebp} type="image/webp" />}
            <img
              src={data.image}
              alt={data.imageAlt}
              width={data.imageWidth ?? 1200}
              height={data.imageHeight ?? 800}
              loading="eager"
              fetchpriority="high"
              decoding="async"
            />
          </picture>
        </figure>
      )
    }

    <div class="container article-layout">
      {
        tocHeadings.length > 1 && (
          <aside class="article-toc" aria-label="On this page">
            <details open>
              <summary>On this page</summary>
              <ol>
                {tocHeadings.map((heading) => (
                  <li class:list={{ "toc-depth-3": heading.depth === 3 }}>
                    <a href={`#${heading.slug}`}>{heading.text}</a>
                  </li>
                ))}
              </ol>
            </details>
          </aside>
        )
      }

      <article class="article-prose">
        <slot />

        <aside class="article-author heading-group" aria-labelledby="article-author-title">
          <p class="eyebrow">Written by</p>
          <h2 class="content-title" id="article-author-title">{data.author}</h2>
          <p class="section-lead">
            EvaMariaDreams is the independent two-person studio behind Octi
            Flow. We create thoughtful mobile apps and publish practical,
            evidence-aware guides about the habits those products are designed
            to support.
          </p>
          <a class="text-link" href="/about/" rel="author">
            About the studio <span aria-hidden="true">→</span>
          </a>
        </aside>

        <ArticleCta />
      </article>
    </div>

    <div class="container">
      <RelatedArticles posts={relatedPosts} />
    </div>
  </main>
</BaseLayout>
