---
import type { BlogPost } from "../utils/blog";
import BaseLayout from "./BaseLayout.astro";
import ArticleCta from "../components/blog/ArticleCta.astro";
import RelatedArticles from "../components/blog/RelatedArticles.astro";
import {
  formatDate,
  postUrl,
  readingTime,
  topicUrl,
  wordCount,
} from "../utils/blog";

interface Props {
  post: BlogPost;
  relatedPosts: BlogPost[];
  headings: { depth: number; slug: string; text: string }[];
}

const { post, relatedPosts, headings } = Astro.props;
const { data } = post;
const canonical = new URL(postUrl(post), Astro.site).href;
const modifiedDate = data.updatedDate ?? data.publishDate;
const tocHeadings = headings.filter((heading) => heading.depth === 2);
const organizationId = "https://octiflow.app/#organization";
const articleImage = data.socialImage ?? data.image ?? "/images/Octi_Flow_OG.jpg";

const structuredData = [
  {
    "@type": "BlogPosting",
    "@id": `${canonical}#article`,
    headline: data.title,
    description: data.description,
    inLanguage: "en",
    articleSection: data.category,
    keywords: data.tags,
    wordCount: wordCount(post.body),
    isAccessibleForFree: true,
    datePublished: data.publishDate.toISOString(),
    dateModified: modifiedDate.toISOString(),
    mainEntityOfPage: {
      "@type": "WebPage",
      "@id": canonical,
    },
    isPartOf: {
      "@id": "https://octiflow.app/blog/#blog",
    },
    author: {
      "@id": organizationId,
    },
    publisher: {
      "@id": organizationId,
    },
    ...(articleImage && {
      image: {
        "@type": "ImageObject",
        url: new URL(articleImage, Astro.site).href,
        width: data.socialImage || !data.image ? 1200 : data.imageWidth,
        height: data.socialImage || !data.image ? 630 : data.imageHeight,
        ...(data.imageAlt && { caption: data.imageAlt }),
      },
    }),
  },
  {
    "@type": "BreadcrumbList",
    "@id": `${canonical}#breadcrumb`,
    itemListElement: [
      {
        "@type": "ListItem",
        position: 1,
        name: "Octi Flow",
        item: "https://octiflow.app/",
      },
      {
        "@type": "ListItem",
        position: 2,
        name: "Blog",
        item: "https://octiflow.app/blog/",
      },
      {
        "@type": "ListItem",
        position: 3,
        name: data.title,
        item: canonical,
      },
    ],
  },
];
---

<BaseLayout
  title={data.seoTitle ?? `${data.title} - Octi Flow`}
  description={data.description}
  {canonical}
  image={data.socialImage ?? data.image}
  imageAlt={data.imageAlt}
  imageWidth={data.socialImage ? 1200 : data.imageWidth}
  imageHeight={data.socialImage ? 630 : data.imageHeight}
  type="article"
  publishedTime={data.publishDate}
  modifiedTime={modifiedDate}
  articleSection={data.category}
  articleTags={data.tags}
  {structuredData}
>
  <main class="article-page blog-page-surface">
    <header class="article-hero">
      <div class="container article-hero__inner">
        <nav class="breadcrumbs" aria-label="Breadcrumb">
          <a href="/">Octi Flow</a>
          <span aria-hidden="true">/</span>
          <a href="/blog/">Blog</a>
        </nav>
        <p class="eyebrow section-eyebrow">
          <a class="article-category-link" href={topicUrl(data.category)}>{data.category}</a>
        </p>
        <h1 class="blog-gradient-title">{data.title}</h1>
        <p class="article-deck">{data.description}</p>
        <dl class="article-meta" aria-label="Article details">
          <div class="article-meta__item">
            <dt>Author</dt>
            <dd><a href="/about/" rel="author">{data.author}</a></dd>
          </div>
          <div class="article-meta__item">
            <dt>Published</dt>
            <dd>
              <time datetime={data.publishDate.toISOString()}>{formatDate(data.publishDate)}</time>
            </dd>
          </div>
          {
            data.updatedDate && (
              <div class="article-meta__item">
                <dt>Updated</dt>
                <dd>
                  <time datetime={data.updatedDate.toISOString()}>{formatDate(data.updatedDate)}</time>
                </dd>
              </div>
            )
          }
          <div class="article-meta__item">
            <dt>Reading time</dt>
            <dd>{readingTime(post.body)} min</dd>
          </div>
        </dl>
      </div>
    </header>

    {
      data.image && (
        <figure class="container article-cover">
          <picture>
            {data.imageAvif && <source srcset={data.imageAvif} type="image/avif" />}
            {data.imageWebp && <source srcset={data.imageWebp} type="image/webp" />}
            <img
              src={data.image}
              alt={data.imageAlt}
              width={data.imageWidth ?? 1200}
              height={data.imageHeight ?? 800}
              loading="eager"
              fetchpriority="high"
              decoding="async"
            />
          </picture>
        </figure>
      )
    }

    <div class="container article-layout">
      {
        tocHeadings.length > 1 && (
          <aside class="article-toc" aria-label="On this page">
            <details data-article-toc-details>
              <summary>On this page</summary>
              <ol>
                {tocHeadings.map((heading) => (
                  <li>
                    <a href={`#${heading.slug}`}>{heading.text}</a>
                  </li>
                ))}
              </ol>
            </details>
          </aside>
        )
      }

      <article class="article-prose">
        <slot />

        <aside class="article-author" aria-labelledby="article-author-title">
          <p class="eyebrow article-author__eyebrow">Written by</p>
          <h2 id="article-author-title">{data.author}</h2>
          <p>
            EvaMariaDreams is the independent two-person studio behind Octi Flow.
            Our health articles prioritize established guidance and peer-reviewed
            research, and we state important evidence limits rather than filling
            gaps with assumptions.
          </p>
          <div class="article-author__links">
            <a class="text-link" href="/about/" rel="author">
              About the studio<span aria-hidden="true">…</span>
            </a>
            <a class="text-link" href="/editorial-standards/">
              Editorial standards<span aria-hidden="true">…</span>
            </a>
          </div>
        </aside>

        <ArticleCta />
      </article>
    </div>

    <div class="container">
      <RelatedArticles posts={relatedPosts} />
    </div>

    <script is:inline>
      (() => {
        const details = document.querySelector("[data-article-toc-details]");
        if (!details) return;
        if (window.matchMedia("(min-width: 921px)").matches) {
          details.open = true;
        }
      })();
    </script>
  </main>
</BaseLayout>

<style>
  .article-meta {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    max-width: 780px;
    margin: 30px 0 0;
    padding: 0;
    border-top: 1px solid rgb(7 48 128 / 10%);
    border-bottom: 1px solid rgb(7 48 128 / 10%);
  }

  .article-meta__item {
    min-width: 0;
    padding: 16px 18px 17px 0;
  }

  .article-meta__item + .article-meta__item {
    padding-left: 18px;
    border-left: 1px solid rgb(7 48 128 / 8%);
  }

  .article-meta dt {
    margin: 0 0 5px;
    color: var(--color-text-muted);
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 0.07em;
    line-height: 1.2;
    text-transform: uppercase;
  }

  .article-meta dd {
    margin: 0;
    color: var(--color-text-body);
    font-size: 14px;
    font-weight: 650;
    line-height: 1.4;
  }

  .article-meta a {
    color: var(--color-brand-strong);
    text-decoration: none;
  }

  .article-meta a:hover {
    color: var(--color-brand);
    text-decoration: underline;
    text-underline-offset: 0.18em;
  }

  @media (max-width: 720px) {
    .article-meta {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      margin-top: 24px;
    }

    .article-meta__item,
    .article-meta__item + .article-meta__item {
      padding: 13px 14px 14px 0;
      border-left: 0;
    }

    .article-meta__item:nth-child(even) {
      padding-left: 14px;
      border-left: 1px solid rgb(7 48 128 / 8%);
    }

    .article-meta__item:nth-child(n + 3) {
      border-top: 1px solid rgb(7 48 128 / 8%);
    }
  }
</style>
