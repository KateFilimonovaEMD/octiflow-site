---
import SiteFooter from "../components/SiteFooter.astro";
import SiteHeader from "../components/SiteHeader.astro";
import "../styles/site.css";

interface Props {
  title: string;
  description: string;
  canonical: string;
  image?: string;
  imageAlt?: string;
  type?: "website" | "article";
  robots?: string;
  publishedTime?: Date;
  modifiedTime?: Date;
  structuredData?: Record<string, unknown>;
}

const {
  title,
  description,
  canonical,
  image,
  imageAlt,
  type = "website",
  robots = "index,follow",
  publishedTime,
  modifiedTime,
  structuredData,
} = Astro.props;

const absoluteImage = image ? new URL(image, Astro.site).href : undefined;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#073080" />
    <meta name="robots" content={robots} />
    <link rel="canonical" href={canonical} />

    <title>{title}</title>
    <meta name="description" content={description} />

    <meta property="og:site_name" content="Octi Flow" />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    {absoluteImage && <meta property="og:image" content={absoluteImage} />}
    {absoluteImage && imageAlt && <meta property="og:image:alt" content={imageAlt} />}
    {publishedTime && <meta property="article:published_time" content={publishedTime.toISOString()} />}
    {modifiedTime && <meta property="article:modified_time" content={modifiedTime.toISOString()} />}

    <meta name="twitter:card" content={absoluteImage ? "summary_large_image" : "summary"} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {absoluteImage && <meta name="twitter:image" content={absoluteImage} />}

    <link
      rel="icon"
      href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'%3E%3Ccircle cx='50' cy='50' r='45' fill='%23015cc6'/%3E%3C/svg%3E"
    />
    <link
      rel="alternate"
      type="application/rss+xml"
      title="Octi Flow Blog"
      href={new URL("/rss.xml", Astro.site)}
    />
    {structuredData && (
      <script is:inline type="application/ld+json" set:html={JSON.stringify(structuredData)} />
    )}
  </head>

  <body>
    <SiteHeader />
    <slot />
    <SiteFooter />
    <script src="../scripts/site.js"></script>
  </body>
</html>
