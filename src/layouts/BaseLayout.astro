---
import SiteFooter from "../components/SiteFooter.astro";
import SiteHeader from "../components/SiteHeader.astro";
import "../styles/site.css";

interface Props {
  title: string;
  description: string;
  canonical: string;
  image?: string;
  imageAlt?: string;
  imageWidth?: number;
  imageHeight?: number;
  type?: "website" | "article";
  robots?: string;
  publishedTime?: Date;
  modifiedTime?: Date;
  structuredData?:
    | Record<string, unknown>
    | Record<string, unknown>[];
}

const {
  title,
  description,
  canonical,
  image = "/images/Octi_Flow_OG.jpg",
  imageAlt,
  imageWidth = 1200,
  imageHeight = 630,
  type = "website",
  robots = "index,follow",
  publishedTime,
  modifiedTime,
  structuredData,
} = Astro.props;

const absoluteImage = new URL(image, Astro.site).href;
const imageExtension = new URL(absoluteImage).pathname.split(".").pop()?.toLowerCase();
const imageType =
  imageExtension === "png"
    ? "image/png"
    : imageExtension === "webp"
      ? "image/webp"
      : imageExtension === "avif"
        ? "image/avif"
        : "image/jpeg";

const organizationId = "https://octiflow.app/#organization";
const applicationId = "https://octiflow.app/#app";
const pageStructuredData = structuredData
  ? Array.isArray(structuredData)
    ? structuredData
    : [structuredData]
  : [];

const structuredDataGraph = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Organization",
      "@id": organizationId,
      name: "EvaMariaDreams",
      url: "https://evamariadreams.com/",
      sameAs: [
        "https://www.instagram.com/evamariadreams/",
        "https://www.threads.com/@evamariadreams",
        "https://www.facebook.com/evamariadreamsapp",
        "https://www.reddit.com/user/AdExpert5320/",
        "https://www.tiktok.com/@evamariadreams",
        "https://www.youtube.com/@evamariadreamsapp",
      ],
      founder: [
        {
          "@type": "Person",
          name: "Kate Filimonova",
        },
        {
          "@type": "Person",
          name: "Eugene Filimonov",
        },
      ],
    },
    {
      "@type": "SoftwareApplication",
      "@id": applicationId,
      name: "Octi Flow",
      alternateName: "Octi Flow Hydration Tracker",
      url: "https://octiflow.app/",
      description:
        "A hydration tracker and water reminder app designed to make daily routines feel simple, supportive, and rewarding.",
      applicationCategory: "HealthApplication",
      operatingSystem: "iOS",
      isAccessibleForFree: true,
      downloadUrl:
        "https://apps.apple.com/app/octi-flow/id6783334530",
      offers: {
        "@type": "Offer",
        price: "0",
        priceCurrency: "USD",
        url: "https://apps.apple.com/app/octi-flow/id6783334530",
      },
      creator: {
        "@id": organizationId,
      },
      publisher: {
        "@id": organizationId,
      },
    },
    ...pageStructuredData.map(({ "@context": _context, ...node }) => node),
  ],
};
const structuredDataJson = JSON.stringify(structuredDataGraph).replace(
  /</g,
  "\\u003c",
);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#073080" />
    <meta name="robots" content={robots} />
    <meta name="apple-itunes-app" content="app-id=6783334530" />
    <link rel="canonical" href={canonical} />

    <title>{title}</title>
    <meta name="description" content={description} />

    <meta property="og:site_name" content="Octi Flow" />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={absoluteImage} />
    <meta property="og:image:type" content={imageType} />
    <meta property="og:image:width" content={String(imageWidth)} />
    <meta property="og:image:height" content={String(imageHeight)} />
    {imageAlt && <meta property="og:image:alt" content={imageAlt} />}
    {publishedTime && <meta property="article:published_time" content={publishedTime.toISOString()} />}
    {modifiedTime && <meta property="article:modified_time" content={modifiedTime.toISOString()} />}

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={absoluteImage} />
    {imageAlt && <meta name="twitter:image:alt" content={imageAlt} />}

    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link
      rel="alternate"
      type="application/rss+xml"
      title="Octi Flow Blog"
      href={new URL("/rss.xml", Astro.site)}
    />
    <script
      is:inline
      type="application/ld+json"
      set:html={structuredDataJson}
    />
  </head>

  <body>
    <SiteHeader />
    <slot />
    <SiteFooter />
    <script src="../scripts/site.js"></script>
  </body>
</html>
