---
import '../styles.css';

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;

const canonical = new URL(
  Astro.url.pathname,
  'https://octiflow.app'
).href;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#073080" />
    <meta name="robots" content="index,follow" />

    <link rel="canonical" href={canonical} />

    <title>{title}</title>
    <meta name="description" content={description} />

    <link
      rel="icon"
      href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'%3E%3Ccircle cx='50' cy='50' r='45' fill='%23015cc6'/%3E%3C/svg%3E"
    />
  </head>

  <body>
    <nav aria-label="Primary navigation">
      <div class="container nav-inner">
        <a class="brand" href="/" aria-label="Octi Flow home">
          <img
            class="brand-logo"
            src="/assets/img/octi-flow-logo.png"
            alt="Octi Flow"
            width="500"
            height="216"
            decoding="async"
          />
        </a>

        <a
          class="studio-link"
          href="https://evamariadreams.com/"
          aria-label="EvaMariaDreams home"
        >
          <img
            class="studio-logo"
            src="/assets/img/emd-logo.png"
            alt="EvaMariaDreams"
            width="240"
            height="80"
            decoding="async"
          />
        </a>
      </div>
    </nav>

    <main>
      <slot />
    </main>

    <footer>
      <div class="container apple-footer">
        <div class="apple-footer-legal">
          <span>Copyright 2026 EvaMariaDreams. All rights reserved.</span>

          <div class="apple-footer-links">
            <a href="https://evamariadreams.com/">EvaMariaDreams</a>
            <a href="/privacy">Privacy Policy</a>
            <a href="/terms">Terms of Use</a>
            <a href="/support">Support</a>
            <a href="/contact">Contact</a>
          </div>
        </div>
      </div>
    </footer>

    <script src="/assets/js/site.js" defer></script>
  </body>
</html>