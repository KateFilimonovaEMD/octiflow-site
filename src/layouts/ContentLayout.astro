---
import BaseLayout from "./BaseLayout.astro";

interface TocItem {
  href: string;
  label: string;
}

interface Props {
  title: string;
  description: string;
  canonical: string;
  heroTitle: string;
  heroDescription: string;
  tocLabel: string;
  tocItems: TocItem[];
}

const {
  title,
  description,
  canonical,
  heroTitle,
  heroDescription,
  tocLabel,
  tocItems,
} = Astro.props;
---

<BaseLayout {title} {description} {canonical}>
    <main>
      <header class="hero">
        <div class="container reveal">
          <h1 class="page-title">{heroTitle}</h1>
          <p class="page-lead">{heroDescription}</p>
        </div>
      </header>

      <div
        class:list={[
          "container",
          "layout",
          { "layout-single": tocItems.length === 0 },
        ]}
      >
        {
          tocItems.length > 0 && (
            <aside class="toc" aria-label={tocLabel}>
              <details class="toc-disclosure">
                <summary>Jump to a section</summary>

                <div class="toc-menu">
                  {tocItems.map((item) => (
                    <a class="nav-link toc-link" href={item.href}>
                      {item.label}
                    </a>
                  ))}
                </div>
              </details>
            </aside>
          )
        }

        <article
          class:list={[
            "policy",
            "content-page",
            { "contact-page": tocItems.length === 0 },
          ]}
        >
          <slot />
        </article>
      </div>
    </main>
</BaseLayout>
